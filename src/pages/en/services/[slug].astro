---
import { getCollection } from 'astro:content';
import ServiceLayout from '../../../layouts/ServiceLayout.astro';
import PersonnelFoodSectionEn from '../../../components/food/PersonnelFoodSectionEn.astro';

export async function getStaticPaths() {
  const all = await getCollection('services');
  const enServices = all
    .filter((entry) => entry.id.startsWith('en/'))
    .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
  return enServices.map((entry) => {
    const slug = entry.id.slice('en/'.length);
    const families: Record<string, string[]> = {
      transport: ['staff-shuttle', 'factory-transport', 'urban-vip', 'school-office'],
      trade: ['import-export', 'customs-port', 'sourcing', 'trade-consulting'],
      workplace: ['personnel-food'],
    };
    const currentSlug = slug as string;
    const family = Object.keys(families).find((name) => families[name].includes(currentSlug));
    const siblings = (family ? families[family] : []).filter((candidate) => candidate !== currentSlug);
    const preferred = siblings.flatMap((candidate) => {
      const match = enServices.find((service) => service.id === `en/${candidate}`);
      return match ? [match] : [];
    });
    const remaining = enServices.filter((candidate) => candidate.id !== entry.id && !preferred.includes(candidate));
    const relatedServices = [...preferred, ...remaining].slice(0, 3)
      .map((candidate) => ({
        slug: candidate.id.slice('en/'.length),
        title: candidate.data.title,
        tag: candidate.data.tag || candidate.data.kicker || '',
        summary: candidate.data.summary || candidate.data.description,
      }));
    return { params: { slug }, props: { entry, relatedServices } };
  });
}

const { entry, relatedServices } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const data = entry.data;
const slug = Astro.params.slug!;
const lang = 'en';
---

{slug === 'personnel-food' ? (
  <PersonnelFoodSectionEn
    title={data.title}
    description={data.description}
    metaDescription={data.meta}
    faqs={data.faqs}
    noteTitle={data.note_title}
    noteBody={data.note_body}
    noteItems={data.note_items}
  />
) : (
  <ServiceLayout
    lang={lang}
    slug={slug}
    title={data.title}
    description={data.description}
    metaDescription={data.meta}
    image={data.image}
    imageAlt={data.image_alt}
    kicker={data.kicker}
    highlight={data.highlight}
    excerpt={data.summary || data.description}
    points={data.points}
    metrics={data.metrics as any}
    features={data.features as any}
    processTitle={data.process_title}
    processDesc={data.process_desc}
    process={data.process as any}
    detailsTitle={data.details_title}
    detailsBody={data.details_body}
    detailsItems={data.details_items}
    noteTitle={data.note_title}
    noteBody={data.note_body}
    noteItems={data.note_items}
    relatedServices={relatedServices}
    ctaTitle={data.cta_title}
    ctaBody={data.cta_body}
    ctaLabel={data.cta_label}
    introTitle={data.intro_title}
    intro={data.intro}
    asideTitle={data.aside_title}
    asideText={data.aside_text}
    asideItems={data.aside_items}
    storyKicker={data.story_kicker}
    storyTitle={data.story_title}
    storyBody={data.story_body}
    storyItems={data.story_items}
    storyImage={data.story_image}
    storyAlt={data.story_alt}
    faqs={data.faqs}
  >
    {slug === 'staff-shuttle' && (
<>
      <section class="content-section" aria-labelledby="shuttle-guides-title" style="background:var(--surface-white);">
        <div class="container">
          <div class="section-header reveal">
            <span class="section-label">Staff shuttle guides</span>
            <h2 id="shuttle-guides-title">Three guides to read before you decide</h2>
            <p>Outsourcing a factory shuttle, estimating the rate and running an office service: each page answers one common question.</p>
          </div>
          <div class="related-services__grid">
            <a class="related-service-card" href={`${baseUrl}/en/articles/factory-shuttle-outsourcing-qazvin/`}>
              <small>Outsourcing</small>
              <strong>Factory Shuttle Service in Qazvin: 7 Reasons to Outsource</strong>
              <span>The hidden cost of an in-house shuttle and the contract clauses to ask for.</span>
            </a>
            <a class="related-service-card" href={`${baseUrl}/en/articles/staff-shuttle-pricing-qazvin/`}>
              <small>Pricing</small>
              <strong>Staff Shuttle Pricing in Qazvin: What Sets the Rate</strong>
              <span>Five cost drivers and how to compare two proposals.</span>
            </a>
            <a class="related-service-card" href={`${baseUrl}/en/articles/office-staff-shuttle-qazvin/`}>
              <small>Offices</small>
              <strong>Office Shuttle Service in Qazvin: Welfare That Retains Staff</strong>
              <span>Three service models and a four-step launch.</span>
            </a>
            <a class="related-service-card" href={`${baseUrl}/en/articles/company-shuttle-service-qazvin/`}>
              <small>Fleet</small>
              <strong>Company Shuttle Service in Qazvin: Choosing a Fleet</strong>
              <span>Bus, minibus, van and car capacity for each route.</span>
            </a>
            <a class="related-service-card" href={`${baseUrl}/en/articles/industrial-park-shuttle-qazvin/`}>
              <small>Park routes</small>
              <strong>Industrial Park Shuttle Service in Qazvin: Routes and Shifts</strong>
              <span>Gate timing, evening shifts and the night return.</span>
            </a>
            <a class="related-service-card" href={`${baseUrl}/en/articles/qazvin-shuttle-service-coverage/`}>
              <small>Coverage</small>
              <strong>Shuttle Service in Qazvin: Parks, Factories and Offices</strong>
              <span>Liya, Alborz, Caspian 1 and 2, Alvand, Khorramdasht, Eshtehard, Nazarabad.</span>
            </a>
          </div>
        </div>
      </section>
</>
    )}
  </ServiceLayout>
)}
