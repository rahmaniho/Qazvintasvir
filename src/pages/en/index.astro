---
import HomeLayout from '../../layouts/HomeLayout.astro';
import Hero from '../../components/home/Hero.astro';
import ClientLogoMarquee from '../../components/home/ClientLogoMarquee.astro';
import HomeDirectory from '../../components/home/HomeDirectory.astro';
import { itemListSchema } from '../../lib/schema';

const lang = 'en';
const site = Astro.site?.toString() || 'https://qazvintasvir.ir';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteClean = site.endsWith('/') ? site.slice(0,-1) : site;
const siteUrl = `${siteClean}${base}`;
const canonical = `${siteUrl}/en/`;
const hreflang = [
  { lang: 'fa', href: `${siteUrl}/fa/` },
  { lang: 'en', href: canonical },
  { lang: 'x-default', href: `${siteUrl}/fa/` },
];
const servicesList = itemListSchema("Services of Qazvin Tasvir Company", [
  { name: "Permitted goods import and export", url: `${siteUrl}/en/services/import-export/` },
  { name: "Customs clearance and port affairs", url: `${siteUrl}/en/services/customs-port/` },
  { name: "Raw materials and equipment sourcing", url: `${siteUrl}/en/services/sourcing/` },
  { name: "Factory staff transportation", url: `${siteUrl}/en/services/factory-transport/` },
  { name: "Urban transport and VIP services", url: `${siteUrl}/en/services/urban-vip/` },
  { name: "School, office and company shuttles", url: `${siteUrl}/en/services/school-office/` },
  { name: "Staff meals and corporate catering", url: `${siteUrl}/en/services/personnel-food/` },
  { name: "Trade consulting and opening letters of credit", url: `${siteUrl}/en/services/trade-consulting/` },
]);
---

<HomeLayout
  lang={lang}
  title="Qazvin Tasvir | Trade, Transport & Staff Catering"
  description="Qazvin Tasvir Company (est. 1995) provides permitted-goods trade, customs clearance, staff transport and corporate catering in Qazvin. Call +98 912 281 5189."
  canonical={canonical}
  hreflang={hreflang}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(servicesList)}></script>
  </Fragment>

  <Hero lang={lang} />
  <ClientLogoMarquee lang={lang} />
  <HomeDirectory lang={lang} />
</HomeLayout>
