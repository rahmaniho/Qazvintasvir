---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
const lang = 'en';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site?.toString() || 'https://qazvintasvir.ir';
const siteClean = site.endsWith('/') ? site.slice(0,-1) : site;
const canonical = `${siteClean}${baseUrl}/en/contact/`;
const hreflang = [
  { lang: 'fa', href: `${siteClean}${baseUrl}/fa/contact/` },
  { lang: 'en', href: canonical },
  { lang: 'x-default', href: `${siteClean}${baseUrl}/fa/contact/` },
];
---

<BaseLayout lang={lang} title="Contact Qazvin Tasvir | Consultation, quotation & contracts" description="Contact Qazvin Tasvir: +98 28 3257 3842, +98 912 281 5189, WhatsApp or consultation form. Office: Unit 208, Niayesh Complex, next to Pasteur Hospital, Qazvin, Iran." canonical={canonical} hreflang={hreflang}>
  <section class="hero" style="padding-block:48px;">
    <div class="container">
      <h1 style="color:#fff;">Contact Qazvin Tasvir</h1>
      <p class="hero__lead">Contact us for a consultation or quotation, or to discuss a contract. We’ll respond promptly.</p>
    </div>
  </section>
  <ContactForm lang={lang} />
</BaseLayout>
