---
import BaseLayout from '../../layouts/BaseLayout.astro';
const lang = 'en';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site?.toString() || 'https://rahmaniho.github.io';
const siteClean = site.endsWith('/') ? site.slice(0,-1) : site;
const canonical = `${siteClean}${baseUrl}/en/about/`;
const hreflang = [
  { lang: 'fa', href: `${siteClean}${baseUrl}/fa/about/` },
  { lang: 'en', href: canonical },
  { lang: 'x-default', href: `${siteClean}${baseUrl}/fa/about/` },
];
---

<BaseLayout lang={lang} title="About Qazvin Tasvir Company — 31 years of experience | Est. 1995" description="Qazvin Tasvir Company (ID 10861415215) — 31+ years of experience in trading, import & export, transport and staff catering since 1995, managed by Saeed Aminzadeh." canonical={canonical} hreflang={hreflang}>
  <section class="hero" style="padding-block:48px;">
    <div class="container">
      <h1 style="color:#fff;">31+ years of trust, from Qazvin to global markets</h1>
      <p class="hero__lead">Qazvin Tasvir has stood beside industries in Qazvin since 1995.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div style="max-width:800px; margin-inline:auto;">
        <h2>Qazvin Tasvir Company</h2>
        <p style="margin-top:12px;">Founded in 1995 by Saeed Aminzadeh, Qazvin Tasvir Company (Ltd) provides trading, transport and corporate support services. With a modern fleet of buses, minibuses and vans, and partnerships with brands such as LG, Nestlé, Unilever and Henkel, we serve over 100 organizations.</p>
        <p style="margin-top:12px;">From Caspian and Alborz industrial parks to southern ports, we keep your supply and mobility chain organized and transparent.</p>
        <ul style="margin-top:16px; display:grid; gap:8px;">
          <li><strong>National ID:</strong> <bdi class="bidi-ltr" dir="ltr">10861415215</bdi> — <strong>Tax ID:</strong> <bdi class="bidi-ltr" dir="ltr">411386837665</bdi></li>
          <li><strong>Management:</strong> Saeed Aminzadeh (CEO) — Asghar Taghilou (Chairman)</li>
          <li><strong>Headquarters:</strong> Qazvin Tasvir Company, 2nd floor, Unit 208, Niayesh Commercial Complex, next to Pasteur Hospital, Qazvin, Iran</li>
          <li><strong>Coverage:</strong> Qazvin and its industrial parks</li>
        </ul>
        <p style="margin-top:16px; color:var(--text-muted); font-style:italic;">For the company’s full legal profile, see the <a href={`${baseUrl}/en/legal/`} style="color:var(--sky-blue); text-decoration:underline;">legal identity page</a>.</p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <header class="section-header">
        <h2 class="section-title">Registered fields of activity</h2>
      </header>
      <div class="about-activity-grid">
        <article class="card reveal"><h3>Transportation</h3><p>Staff shuttles, urban and VIP transport, and fleet services.</p></article>
        <article class="card reveal"><h3>Trade and marketing</h3><p>Import and export of permitted goods, customs clearance and sourcing.</p></article>
        <article class="card reveal"><h3>Financial and accounting support</h3><p>Financial and accounting consultation, including support with letters of credit.</p></article>
        <article class="card reveal"><h3>Administrative and employee services</h3><p>Staff catering and other corporate employee services.</p></article>
      </div>
    </div>
  </section>
</BaseLayout>
