---
import BaseLayout from '../../layouts/BaseLayout.astro';
const lang = 'en';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site?.toString() || 'https://rahmaniho.github.io';
const siteClean = site.endsWith('/') ? site.slice(0,-1) : site;
const canonical = `${siteClean}${baseUrl}/en/about/`;
const hreflang = [
  { lang: 'fa', href: `${siteClean}${baseUrl}/fa/about/` },
  { lang: 'en', href: canonical },
  { lang: 'x-default', href: `${siteClean}${baseUrl}/fa/about/` },
];
---

<BaseLayout lang={lang} title="About Qazvin Tasvir Company — 31 years of experience | Est. 1995" description="Qazvin Tasvir Company (ID 10861415215) — 31+ years of experience in trading, import & export, transport and staff catering since 1995, managed by Saeed Aminzadeh." canonical={canonical} hreflang={hreflang}>
  <section class="hero" style="padding-block:48px;">
    <div class="container">
      <h1 style="color:#fff;">31+ years of trust, from Qazvin to global markets</h1>
      <p class="hero__lead">Qazvin Tasvir has stood beside industries in Qazvin since 1995.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div style="max-width:800px; margin-inline:auto;">
        <h2>Qazvin Tasvir Company</h2>
        <p style="margin-top:12px;">Founded in 1995 by Saeed Aminzadeh, Qazvin Tasvir Company (Ltd) provides trading, transport and corporate support services. With a modern fleet of buses, minibuses and vans, and partnerships with brands such as LG, Nestlé, Unilever and Henkel, we serve over 100 organizations.</p>
        <ul style="margin-top:16px; display:grid; gap:8px;">
          <li><strong>National ID:</strong> 10861415215 — <strong>Tax ID:</strong> 411386837665</li>
          <li><strong>Management:</strong> Saeed Aminzadeh (CEO) — Asghar Taghilou (Chairman)</li>
          <li><strong>Headquarters:</strong> Abadgaran Commercial Complex, 6th floor, room 604, Ferdowsi St, Qazvin, Iran</li>
        </ul>
        <p style="margin-top:16px; color:var(--text-muted); font-style:italic;">For full legal and corporate resume (in Persian), please see the <a href={`${baseUrl}/fa/about/`} style="color:var(--sky-blue); text-decoration:underline;">Persian about page</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>
