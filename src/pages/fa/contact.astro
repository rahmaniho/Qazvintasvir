---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
const lang = 'fa';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site?.toString() || 'https://qazvintasvir.ir';
const siteClean = site.endsWith('/') ? site.slice(0,-1) : site;
const canonical = `${siteClean}${baseUrl}/fa/contact/`;
const hreflang = [
  { lang: 'fa', href: canonical },
  { lang: 'en', href: `${siteClean}${baseUrl}/en/contact/` },
  { lang: 'x-default', href: canonical },
];
---

<BaseLayout lang={lang} title="تماس با قزوین تصویر | مشاوره، استعلام و قرارداد" description="تماس با قزوین تصویر: ۰۲۸ ۳۲۵۷ ۳۸۴۲ و ۰۹۱۲ ۲۸۱ ۵۱۸۹؛ واتساپ و فرم درخواست مشاوره. دفتر: قزوین، جنب بیمارستان پاستور، مجتمع نیایش، واحد ۲۰۸." canonical={canonical} hreflang={hreflang}>
  <section class="hero" style="padding-block:48px;">
    <div class="container">
      <h1 style="color:#fff;">تماس با قزوین تصویر</h1>
      <p class="hero__lead">برای مشاوره، استعلام قیمت یا عقد قرارداد با ما در تماس باشید؛ در کوتاه‌ترین زمان پاسخ می‌دهیم.</p>
    </div>
  </section>
  <ContactForm lang={lang} />

  <section class="section">
    <div class="container">
      <div class="card reveal" style="max-width:900px; margin-inline:auto; text-align:center;">
        <h3>اطلاعات تماس مستقیم</h3>
        <p style="margin-top:8px;">شرکت قزوین تصویر — قزوین، جنب بیمارستان پاستور، مجتمع تجاری نیایش، طبقه‌ی <bdi class="bidi-ltr" dir="ltr">۲</bdi>، واحد <bdi class="bidi-ltr" dir="ltr">۲۰۸</bdi></p>
        <p style="margin-top:8px;"><strong>دفتر مرکزی:</strong> <a href="tel:+982832573842" dir="ltr" class="bidi-ltr" style="color:var(--sky-blue);">۰۲۸ ۳۲۵۷ ۳۸۴۲</a></p>
        <p style="margin-top:8px;"><strong>موبایل:</strong> <a href="tel:+989122815189" dir="ltr" class="bidi-ltr" style="color:var(--sky-blue);">۰۹۱۲ ۲۸۱ ۵۱۸۹</a> — <a href="tel:+989352815189" dir="ltr" class="bidi-ltr" style="color:var(--sky-blue);">۰۹۳۵ ۲۸۱ ۵۱۸۹</a> — <strong>واتساپ:</strong> <a href="https://wa.me/989122815189" target="_blank" rel="noopener" style="color:var(--whatsapp);">ارسال پیام</a></p>
        <p style="margin-top:8px; font-size:0.9rem; color:var(--text-muted);">شناسه ملی: <bdi class="bidi-ltr" dir="ltr">۱۰۸۶۱۴۱۵۲۱۵</bdi> — کد پستی: <bdi class="bidi-ltr" dir="ltr">۳۴۱۳۶۹۱۵۸۹</bdi></p>
      </div>
    </div>
  </section>
</BaseLayout>
