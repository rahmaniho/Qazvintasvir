---
import BaseLayout from '../../layouts/BaseLayout.astro';
const lang = 'fa';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site?.toString() || 'https://rahmaniho.github.io';
const siteClean = site.endsWith('/') ? site.slice(0,-1) : site;
const canonical = `${siteClean}${baseUrl}/fa/about/`;
const hreflang = [
  { lang: 'fa', href: canonical },
  { lang: 'en', href: `${siteClean}${baseUrl}/en/about/` },
  { lang: 'x-default', href: canonical },
];
---

<BaseLayout lang={lang} title="درباره قزوین تصویر — ۳۱ سال تجربه در بازرگانی و ترابری | تأسیس ۱۳۷۴" description="معرفی شرکت قزوین تصویر (شناسه ملی ۱۰۸۶۱۴۱۵۲۱۵) با مدیریت سعید امین‌زاده — بیش از ۳۱ سال تجربه در بازرگانی، واردات و صادرات، ترابری و تأمین غذای پرسنل از سال ۱۳۷۴." canonical={canonical} hreflang={hreflang}>
  <section class="hero" style="padding-block:48px 40px;">
    <div class="container">
      <h1 style="color:#fff;">بیش از <bdi class="bidi-ltr" dir="ltr">۳۱</bdi> سال اعتماد، از قزوین تا بازارهای جهانی</h1>
      <p class="hero__lead">قزوین تصویر از سال <bdi class="bidi-ltr" dir="ltr">۱۳۷۴</bdi> در کنار صنایع استان قزوین بوده است.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="about-grid">
        <div class="reveal">
          <h2>شرکت قزوین تصویر</h2>
          <p style="margin-top:12px;">شرکت قزوین تصویر (با مسئولیت محدود) در سال <bdi class="bidi-ltr" dir="ltr">۱۳۷۴</bdi> با مدیریت سعید امین‌زاده تأسیس شد. مأموریت ما تسهیل زنجیرهٔ تأمین، حمل‌ونقل و پشتیبانی سازمانی برای صنایع بزرگ استان قزوین است.</p>
          <p style="margin-top:12px;">با تکیه بر ناوگان مجهز اتوبوس، مینی‌بوس و ون و همکاری با برندهای معتبری همچون ال‌جی، نستله، یونیلیور و هنکل، توانسته‌ایم اعتماد بیش از <bdi class="bidi-ltr" dir="ltr">۱۰۰</bdi> سازمان را جلب کنیم.</p>
          <p style="margin-top:12px;">از شهرک‌های صنعتی کاسپین و البرز تا بنادر جنوبی، زنجیرهٔ تأمین و جابه‌جایی شما را با نظم و شفافیت همراهی می‌کنیم.</p>
          <ul style="margin-top:20px; display:grid; gap:10px;">
            <li style="display:flex; gap:8px; align-items:center; font-weight:600;"><span style="color:var(--success);">✓</span> شناسه ملی <bdi class="bidi-ltr" dir="ltr">۱۰۸۶۱۴۱۵۲۱۵</bdi> — شناسه مالیاتی <bdi class="bidi-ltr" dir="ltr">۴۱۱۳۸۶۸۳۷۶۶۵</bdi></li>
            <li style="display:flex; gap:8px; align-items:center; font-weight:600;"><span style="color:var(--success);">✓</span> مدیریت: سعید امین‌زاده (مدیرعامل) — اصغر تقی‌لو (رئیس هیئت مدیره)</li>
            <li style="display:flex; gap:8px; align-items:center; font-weight:600;"><span style="color:var(--success);">✓</span> دفتر مرکزی: قزوین، جنب بیمارستان پاستور، مجتمع تجاری نیایش، طبقهٔ <bdi class="bidi-ltr" dir="ltr">۲</bdi>، واحد <bdi class="bidi-ltr" dir="ltr">۲۰۸</bdi>، شرکت قزوین تصویر</li>
            <li style="display:flex; gap:8px; align-items:center; font-weight:600;"><span style="color:var(--success);">✓</span> پوشش کامل قزوین و شهرک‌های صنعتی</li>
          </ul>
        </div>
        <div class="reveal">
          <img src={`${baseUrl}/assets/img/sections/about-office.webp`} alt="دفتر قزوین تصویر" width="560" height="380" loading="eager" decoding="async" style="border-radius:var(--r-lg); width:100%; object-fit:cover; aspect-ratio:4/3;" />
          <div class="card" style="margin-top:20px; display:flex; gap:16px; align-items:center;">
            <img src={`${baseUrl}/assets/images/saeed-aminzadeh-avatar.webp`} alt="سعید امین‌زاده" width="64" height="64" style="border-radius:50%; width:64px; height:64px; object-fit:cover;" loading="lazy" decoding="async" />
            <div>
              <strong>سعید امین‌زاده</strong>
              <span style="display:block; color:var(--text-muted); font-size:0.9rem;">مدیرعامل و بنیان‌گذار — عضو هیئت مدیره</span>
              <span style="display:block; color:var(--text-muted); font-size:0.84rem; margin-top:4px;">بیش از <bdi class="bidi-ltr" dir="ltr">۳۱</bdi> سال تجربه در بازرگانی و ترابری صنعتی</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2 style="text-align:center;">زمینه‌های فعالیت ثبت‌شده</h2>
      <div class="about-activity-grid">
        <div class="card reveal"><h3 style="font-size:1rem;">حمل‌ونقل و ترابری</h3><p style="margin-top:8px; font-size:0.92rem;">جابه‌جایی پرسنل، سرویس درون‌شهری و VIP با ناوگان مجهز</p></div>
        <div class="card reveal"><h3 style="font-size:1rem;">بازرگانی و بازاریابی</h3><p style="margin-top:8px; font-size:0.92rem;">واردات و صادرات کالاهای مجاز، ترخیص و تأمین</p></div>
        <div class="card reveal"><h3 style="font-size:1rem;">امور مالی و حسابداری</h3><p style="margin-top:8px; font-size:0.92rem;">مشاوره مالی، حسابداری و گشایش اعتبار</p></div>
        <div class="card reveal"><h3 style="font-size:1rem;">خدمات اداری و رفاهی</h3><p style="margin-top:8px; font-size:0.92rem;">تأمین غذای پرسنل و خدمات رفاهی سازمانی</p></div>
      </div>
    </div>
  </section>
</BaseLayout>
