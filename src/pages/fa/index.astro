---
import HomeLayout from '../../layouts/HomeLayout.astro';
import Hero from '../../components/home/Hero.astro';
import HomeDirectory from '../../components/home/HomeDirectory.astro';
import { organizationSchema, itemListSchema } from '../../lib/schema';

const lang = 'fa';
const site = Astro.site?.toString() || 'https://rahmaniho.github.io';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteClean = site.endsWith('/') ? site.slice(0,-1) : site;
const baseClean = base;
const siteUrl = `${siteClean}${baseClean}`;
const canonical = `${siteUrl}/fa/`;
const hreflang = [
  { lang: 'fa', href: `${siteUrl}/fa/` },
  { lang: 'en', href: `${siteUrl}/en/` },
  { lang: 'x-default', href: `${siteUrl}/fa/` },
];

const org = organizationSchema(siteUrl);
const servicesList = itemListSchema("خدمات تخصصی شرکت قزوین تصویر", [
  { name: "واردات و صادرات کالاهای مجاز", url: `${siteUrl}/fa/services/import-export/` },
  { name: "ترخیص گمرکی و امور بندری", url: `${siteUrl}/fa/services/customs-port/` },
  { name: "تأمین مواد اولیه و تجهیزات", url: `${siteUrl}/fa/services/sourcing/` },
  { name: "ترابری پرسنل کارخانجات", url: `${siteUrl}/fa/services/factory-transport/` },
  { name: "حمل‌ونقل درون‌شهری و سرویس‌های VIP", url: `${siteUrl}/fa/services/urban-vip/` },
  { name: "سرویس مدارس، ادارات و شرکت‌ها", url: `${siteUrl}/fa/services/school-office/` },
  { name: "تأمین غذای پرسنل و وعده‌های سازمانی", url: `${siteUrl}/fa/services/personnel-food/` },
  { name: "مشاوره بازرگانی و گشایش", url: `${siteUrl}/fa/services/trade-consulting/` },
]);
---

<HomeLayout
  lang={lang}
  title="قزوین تصویر | بازرگانی، واردات و صادرات، ترابری و تأمین غذای پرسنل — تأسیس ۱۳۷۴"
  description="شرکت قزوین تصویر (شناسه ملی ۱۰۸۶۱۴۱۵۲۱۵)، با مدیریت سعید امین‌زاده؛ هشت خدمت تخصصی در واردات و صادرات، ترخیص، تأمین صنعتی، ترابری، سرویس VIP و سازمانی، غذای پرسنل و مشاوره بازرگانی. تأسیس ۱۳۷۴. تماس: ۰۹۱۲ ۲۸۱ ۵۱۸۹ و ۰۹۳۵ ۲۸۱ ۵۱۸۹."
  canonical={canonical}
  hreflang={hreflang}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(org)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(servicesList)}></script>
  </Fragment>

  <Hero lang={lang} />
  <HomeDirectory lang={lang} />
</HomeLayout>
