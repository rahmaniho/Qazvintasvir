---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const lang = 'fa';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site?.toString() || 'https://qazvintasvir.ir';
const siteClean = site.endsWith('/') ? site.slice(0,-1) : site;
const canonical = `${siteClean}${baseUrl}/fa/services/`;
const hreflang = [
  { lang: 'fa', href: canonical },
  { lang: 'en', href: `${siteClean}${baseUrl}/en/services/` },
  { lang: 'x-default', href: canonical },
];

const all = await getCollection('services');
const services = all.filter(s => s.id.startsWith('fa/')).sort((a,b) => (a.data.order||0) - (b.data.order||0));
const toPersianDigits = (value: string) => value.replace(/\d/g, (digit) => '۰۱۲۳۴۵۶۷۸۹'[Number(digit)]);

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "خدمات تخصصی شرکت قزوین تصویر",
  itemListElement: services.map((s, idx) => {
    const slug = s.id.slice('fa/'.length);
    return {
    "@type": "ListItem",
    position: idx+1,
    name: s.data.title,
    url: `${siteClean}${baseUrl}/fa/services/${slug}/`
    };
  })
};
---

<BaseLayout lang={lang} title="خدمات تخصصی | قزوین تصویر — هشت مسیر خدمت از بازرگانی تا کیترینگ" description="هشت صفحه مستقل خدمات شرکت قزوین تصویر در حوزه بازرگانی، ترخیص، تأمین، ترابری، VIP، سرویس سازمانی، غذای پرسنل و مشاوره بازرگانی." canonical={canonical} hreflang={hreflang} schema={itemListSchema}>
  <section class="hero" style="padding-block:48px 32px;">
    <div class="container">
      <nav class="breadcrumbs" aria-label="مسیر صفحه"><a href={`${baseUrl}/fa/`}>خانه</a><span class="breadcrumbs__sep">/</span><span aria-current="page">خدمات</span></nav>
      <h1 style="color:#fff; margin-top:16px;">خدمات تخصصی قزوین تصویر</h1>
      <p class="hero__lead">هشت خدمت تخصصی برای پوشش زنجیرهٔ بازرگانی، ترابری و پشتیبانی سازمانی — از واردات تا تأمین غذای پرسنل.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">هشت خدمت تخصصی</span>
        <h2>راهکارهایی برای اینکه زنجیره عملیات شما روان‌تر پیش برود</h2>
        <p>هر خدمت با شناخت نیاز واقعی مجموعه شما شروع می‌شود و تا اجرا و پشتیبانی ادامه دارد.</p>
      </div>

      <div class="services-grid">
        {services.map(s => {
          const slug = s.id.slice('fa/'.length);
          return (
          <article class="service-card reveal">
            <a href={`${baseUrl}/fa/services/${slug}/`} style="display:flex; flex-direction:column; height:100%;">
              <div class="service-card__media">
                {s.data.image ? (
                  <img src={`${baseUrl}${s.data.image}`} alt={s.data.image_alt || s.data.title} width="400" height="250" loading="lazy" decoding="async" />
                ) : <div style="height:100%; background:var(--line-soft); display:grid; place-items:center; color:var(--text-muted);">{s.data.title}</div>}
                <span style="position:absolute; top:12px; inset-inline-start:12px; background:rgba(0,0,0,0.6); color:#fff; padding:4px 10px; border-radius:9999px; font-size:0.74rem; font-weight:700;"><bdi class="bidi-ltr" dir="ltr">{toPersianDigits(String(s.data.order).padStart(2,'0'))}</bdi></span>
              </div>
              <div class="service-card__body">
                <span class="service-card__tag">{s.data.tag}</span>
                <h3>{s.data.title}</h3>
                <p>{s.data.summary || s.data.description}</p>
                <span class="service-card__link">جزئیات خدمت <span aria-hidden="true">←</span></span>
              </div>
            </a>
          </article>
        )})}
      </div>

      <div class="card reveal services-promises">
        <div><strong>بررسی نیاز واقعی</strong><span style="display:block; color:var(--text-muted); font-size:0.88rem; margin-top:4px;">پیشنهاد خدمت بر اساس شرایط مجموعه شما شکل می‌گیرد.</span></div>
        <div><strong>اطلاعات قابل پیگیری</strong><span style="display:block; color:var(--text-muted); font-size:0.88rem; margin-top:4px;">مراحل همکاری و مسئولیت‌ها پیش از شروع روشن می‌شوند.</span></div>
        <div><strong>یک نقطه تماس</strong><span style="display:block; color:var(--text-muted); font-size:0.88rem; margin-top:4px;">برای هماهنگی بازرگانی، ترابری یا غذای سازمانی همراه شما هستیم.</span></div>
      </div>

      <aside class="service-article-promo reveal">
        <div>
          <span class="section-label">راهنمای کاربردی</span>
          <h2>پیش از انتخاب خدمت، تصویر کامل‌تری داشته باشید</h2>
          <p>در یک مقاله، هشت مسیر خدمت قزوین تصویر، اطلاعات لازم برای شروع و نکته‌های مهم هر حوزه را مرور کنید.</p>
        </div>
        <a class="btn btn--secondary" href={`${baseUrl}/fa/articles/services-guide/`}>خواندن راهنمای خدمات <span aria-hidden="true">←</span></a>
      </aside>

      <div style="margin-top:32px;" class="reveal">
        <div class="cta-block">
          <div>
            <h2>نمی‌دانید از کدام خدمت شروع کنید؟</h2>
            <p>شرح کوتاهی از نیازتان را ارسال کنید تا در یک گفت‌وگوی اولیه، مسیر مناسب همکاری را با هم مشخص کنیم.</p>
          </div>
          <a href={`${baseUrl}/fa/contact/`} class="btn btn--accent">درخواست مشاوره →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
