---
import { getCollection } from 'astro:content';
import ServiceLayout from '../../../layouts/ServiceLayout.astro';
import PersonnelFoodSection from '../../../components/food/PersonnelFoodSection.astro';

export async function getStaticPaths() {
  const all = await getCollection('services');
  const faServices = all
    .filter((entry) => entry.id.startsWith('fa/'))
    .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
  return faServices.map((entry) => {
    const slug = entry.id.slice('fa/'.length);
    const families: Record<string, string[]> = {
      transport: ['staff-shuttle', 'factory-transport', 'urban-vip', 'school-office'],
      trade: ['import-export', 'customs-port', 'sourcing', 'trade-consulting'],
      workplace: ['personnel-food'],
    };
    const currentSlug = slug as string;
    const family = Object.keys(families).find((name) => families[name].includes(currentSlug));
    const siblings = (family ? families[family] : []).filter((candidate) => candidate !== currentSlug);
    const preferred = siblings.flatMap((candidate) => {
      const match = faServices.find((service) => service.id === `fa/${candidate}`);
      return match ? [match] : [];
    });
    const remaining = faServices.filter((candidate) => candidate.id !== entry.id && !preferred.includes(candidate));
    const relatedServices = [...preferred, ...remaining].slice(0, 3)
      .map((candidate) => ({
        slug: candidate.id.slice('fa/'.length),
        title: candidate.data.title,
        tag: candidate.data.tag || candidate.data.kicker || '',
        summary: candidate.data.summary || candidate.data.description,
      }));
    return { params: { slug }, props: { entry, relatedServices } };
  });
}

const { entry, relatedServices } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const data = entry.data;
const slug = Astro.params.slug!;
---

{slug === 'personnel-food' ? (
  <PersonnelFoodSection
    noteTitle={data.note_title}
    noteBody={data.note_body}
    noteItems={data.note_items}
  />
) : (
  <ServiceLayout
    lang="fa"
    slug={slug}
    title={data.title}
    description={data.description}
    metaDescription={data.meta}
    image={data.image}
    imageAlt={data.image_alt}
    kicker={data.kicker}
    highlight={data.highlight}
    excerpt={data.summary || data.description}
    points={data.points}
    metrics={data.metrics as any}
    features={data.features as any}
    processTitle={data.process_title}
    processDesc={data.process_desc}
    process={data.process as any}
    detailsTitle={data.details_title}
    detailsBody={data.details_body}
    detailsItems={data.details_items}
    noteTitle={data.note_title}
    noteBody={data.note_body}
    noteItems={data.note_items}
    relatedServices={relatedServices}
    ctaTitle={data.cta_title}
    ctaBody={data.cta_body}
    ctaLabel={data.cta_label}
    introTitle={data.intro_title}
    intro={data.intro}
    asideTitle={data.aside_title}
    asideText={data.aside_text}
    asideItems={data.aside_items}
    storyKicker={data.story_kicker}
    storyTitle={data.story_title}
    storyBody={data.story_body}
    storyItems={data.story_items}
    storyImage={data.story_image}
    storyAlt={data.story_alt}
    faqs={data.faqs}
  >
    {slug === 'staff-shuttle' && (
<>
      <section class="content-section" aria-labelledby="shuttle-guides-title" style="background:var(--surface-white);">
        <div class="container">
          <div class="section-header reveal">
            <span class="section-label">راهنماهای سرویس ایاب و ذهاب</span>
            <h2 id="shuttle-guides-title">پیش از تصمیم، این سه راهنما را بخوانید</h2>
            <p>برون‌سپاری سرویس کارخانه، برآورد قیمت و سرویس ادارات؛ هر صفحه به یک پرسش رایج پاسخ می‌دهد.</p>
          </div>
          <div class="related-services__grid">
            <a class="related-service-card" href={`${baseUrl}/fa/articles/factory-shuttle-outsourcing-qazvin/`}>
              <small>برون‌سپاری</small>
              <strong>سرویس ایاب و ذهاب کارخانه در قزوین؛ ۷ دلیل برون‌سپاری</strong>
              <span>هزینه‌ی پنهان سرویس داخلی و بندهای قرارداد.</span>
            </a>
            <a class="related-service-card" href={`${baseUrl}/fa/articles/staff-shuttle-pricing-qazvin/`}>
              <small>قیمت</small>
              <strong>قیمت سرویس ایاب و ذهاب در قزوین؛ چه چیزی نرخ را می‌سازد؟</strong>
              <span>پنج عامل قیمت و روش مقایسه‌ی دو پیشنهاد.</span>
            </a>
            <a class="related-service-card" href={`${baseUrl}/fa/articles/office-staff-shuttle-qazvin/`}>
              <small>ادارات و شرکت‌ها</small>
              <strong>سرویس ایاب و ذهاب ادارات و شرکت‌ها در قزوین</strong>
              <span>سه مدل سرویس و راه‌اندازی در چهار گام.</span>
            </a>
            <a class="related-service-card" href={`${baseUrl}/fa/articles/company-shuttle-service-qazvin/`}>
              <small>ناوگان</small>
              <strong>سرویس ایاب و ذهاب شرکت‌ها در قزوین؛ انتخاب ناوگان</strong>
              <span>ظرفیت اتوبوس، مینی‌بوس، ون و سواری برای هر مسیر.</span>
            </a>
            <a class="related-service-card" href={`${baseUrl}/fa/articles/industrial-park-shuttle-qazvin/`}>
              <small>شهرک صنعتی</small>
              <strong>سرویس ایاب و ذهاب شهرک صنعتی البرز و لیا؛ مسیر و شیفت</strong>
              <span>مسیر دروازه، شیفت عصر و سرویس بازگشت شب.</span>
            </a>
          </div>
        </div>
      </section>
</>
    )}
  </ServiceLayout>
)}
