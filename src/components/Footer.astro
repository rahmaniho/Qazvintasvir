---
interface Props {
  lang: 'fa' | 'en';
}
const { lang } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const yearDisplay = new Intl.DateTimeFormat(lang === 'fa' ? 'fa-IR-u-ca-persian' : 'en-US', { year: 'numeric' }).format(new Date());

const servicesFa = [
  ["واردات و صادرات کالاهای مجاز", `${baseUrl}/fa/services/import-export/`],
  ["ترخیص گمرکی و امور بندری", `${baseUrl}/fa/services/customs-port/`],
  ["تأمین مواد اولیه و تجهیزات", `${baseUrl}/fa/services/sourcing/`],
  ["ترابری پرسنل کارخانجات", `${baseUrl}/fa/services/factory-transport/`],
  ["حمل‌ونقل درون‌شهری و VIP", `${baseUrl}/fa/services/urban-vip/`],
  ["سرویس مدارس و سازمانی", `${baseUrl}/fa/services/school-office/`],
  ["تأمین غذای پرسنل", `${baseUrl}/fa/services/personnel-food/`],
  ["مشاوره بازرگانی و گشایش", `${baseUrl}/fa/services/trade-consulting/`],
];
const servicesEn = [
  ["Import & Export", `${baseUrl}/en/services/import-export/`],
  ["Customs & Port", `${baseUrl}/en/services/customs-port/`],
  ["Industrial Sourcing", `${baseUrl}/en/services/sourcing/`],
  ["Factory Transport", `${baseUrl}/en/services/factory-transport/`],
  ["Urban & VIP", `${baseUrl}/en/services/urban-vip/`],
  ["School & Office", `${baseUrl}/en/services/school-office/`],
  ["Staff Catering", `${baseUrl}/en/services/personnel-food/`],
  ["Trade Consulting", `${baseUrl}/en/services/trade-consulting/`],
];
const services = lang === 'fa' ? servicesFa : servicesEn;
const pageLinks = lang === 'fa'
  ? [
      ['درباره ما', `${baseUrl}/fa/about/`],
      ['ناوگان ترابری', `${baseUrl}/fa/fleet/`],
      ['برندهای ناوگان', `${baseUrl}/fa/brands/`],
      ['چرا قزوین تصویر؟', `${baseUrl}/fa/why-us/`],
      ['مشتریان و سوابق', `${baseUrl}/fa/clients/`],
      ['اعتبار و شفافیت', `${baseUrl}/fa/trust/`],
      ['رزومه شرکت', `${baseUrl}/fa/resume/`],
      ['شناسنامه حقوقی', `${baseUrl}/fa/legal/`],
    ]
  : [
      ['About us', `${baseUrl}/en/about/`],
      ['Transport fleet', `${baseUrl}/en/fleet/`],
      ['Fleet brands', `${baseUrl}/en/brands/`],
      ['Why Qazvin Tasvir?', `${baseUrl}/en/why-us/`],
      ['Clients & track record', `${baseUrl}/en/clients/`],
      ['Credentials', `${baseUrl}/en/trust/`],
      ['Company resume', `${baseUrl}/en/resume/`],
      ['Legal identity', `${baseUrl}/en/legal/`],
    ];
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="footer-brand__logo" href={`${baseUrl}/${lang}/`} aria-label={lang==='fa' ? 'قزوین تصویر' : 'Qazvin Tasvir'}>
          <img src={`${baseUrl}/assets/images/brand/qazvin-tasvir-mark.png`} alt="" width="34" height="34" loading="lazy" decoding="async" />
          <span>{lang==='fa' ? 'شرکت قزوین تصویر' : 'Qazvin Tasvir Company'}</span>
        </a>
        <p>
          {lang === 'fa'
            ? <>شرکت قزوین تصویر (با مسئولیت محدود — تأسیس <bdi class="bidi-ltr" dir="ltr">۱۳۷۴</bdi>) ارائه‌دهندهٔ خدمات بازرگانی، ترابری و تأمین غذای سازمانی برای صنایع استان قزوین است.</>
            : 'Qazvin Tasvir Company (Ltd — established in 1995) provides trade, transportation and corporate catering services for industries in Qazvin.'}
        </p>
        <p class="footer-brand__contact" style="font-size:0.84rem; color:#64748B;">
          {lang === 'fa' ? (
            <>قزوین، جنب بیمارستان پاستور، مجتمع تجاری نیایش، طبقهٔ <bdi class="bidi-ltr" dir="ltr">۲</bdi>، واحد <bdi class="bidi-ltr" dir="ltr">۲۰۸</bdi>، شرکت قزوین تصویر — <bdi class="bidi-ltr" dir="ltr">۰۹۱۲ ۲۸۱ ۵۱۸۹</bdi> — <bdi class="bidi-ltr" dir="ltr">۰۹۳۵ ۲۸۱ ۵۱۸۹</bdi></>
          ) : (
            <>Qazvin Tasvir Company, 2nd floor, Unit 208, Niayesh Commercial Complex, next to Pasteur Hospital — <bdi class="bidi-ltr" dir="ltr">+98 912 281 5189</bdi> — <bdi class="bidi-ltr" dir="ltr">+98 935 281 5189</bdi></>
          )}
        </p>
      </div>

      <div class="footer-col">
        <h4>{lang==='fa' ? 'خدمات' : 'Services'}</h4>
        <ul>
          {services.slice(0,4).map(([label, href]) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </div>
      <div class="footer-col">
        <h4>{lang === 'fa' ? 'سایر خدمات' : 'More services'}</h4>
        <ul>
          {services.slice(4).map(([label, href]) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </div>
      <div class="footer-col">
        <h4>{lang === 'fa' ? 'صفحه‌های شرکت' : 'Company pages'}</h4>
        <ul>
          {pageLinks.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </div>
      <div class="footer-col">
        <h4>{lang === 'fa' ? 'تماس' : 'Contact'}</h4>
        <ul>
          <li><a href={`${baseUrl}/${lang}/contact/`}>{lang === 'fa' ? 'تماس و درخواست همکاری' : 'Contact & consultation'}</a></li>
          <li><a href={`${baseUrl}/${lang}/services/`}>{lang === 'fa' ? 'همه خدمات' : 'All services'}</a></li>
          <li>{lang === 'fa' ? 'دفتر مرکزی: ' : 'Head office: '}<a href="tel:+982832573842" dir="ltr" class="bidi-ltr">{lang === 'fa' ? '۰۲۸ ۳۲۵۷ ۳۸۴۲' : '+98 28 3257 3842'}</a></li>
          <li><a href="tel:+989122815189" dir="ltr" class="bidi-ltr">{lang === 'fa' ? '۰۹۱۲ ۲۸۱ ۵۱۸۹' : '+98 912 281 5189'}</a></li>
          <li><a href="tel:+989352815189" dir="ltr" class="bidi-ltr">{lang === 'fa' ? '۰۹۳۵ ۲۸۱ ۵۱۸۹' : '+98 935 281 5189'}</a></li>
          <li>{lang === 'fa' ? 'ایمیل: ' : 'Email: '}<a href="mailto:qazvin.tasvir@gmail.com" dir="ltr" class="bidi-ltr">qazvin.tasvir@gmail.com</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© <bdi class="bidi-ltr" dir="ltr" data-year>{yearDisplay}</bdi> {lang === 'fa' ? 'قزوین تصویر' : 'Qazvin Tasvir'}</span>
      <a
        class="karensoft-credit"
        href="https://www.karen-soft.ir"
        target="_blank"
        rel="noopener noreferrer"
        dir={lang === 'fa' ? 'rtl' : 'ltr'}
        aria-label={lang === 'fa' ? 'بازدید از وب‌سایت کارن سافت' : 'Designed and developed by KarenSoft'}
      >
        <span class="karensoft-credit__label" lang={lang} dir={lang === 'fa' ? 'rtl' : 'ltr'}>
          {lang === 'fa' ? 'طراحی و توسعه توسط' : 'Designed & Developed by'}
        </span>
        <span class="karensoft-credit__mark-wrap" aria-hidden="true">
          <img
            class="karensoft-credit__mark"
            src={`${baseUrl}/assets/images/karensoft/mark.png`}
            alt=""
            width="256"
            height="256"
            loading="lazy"
            decoding="async"
          />
        </span>
        <span class="karensoft-credit__wordmarks" dir="ltr" aria-hidden="true">
          <img
            class="karensoft-credit__wordmark karensoft-credit__wordmark--en"
            src={`${baseUrl}/assets/images/karensoft/wordmark-en.png`}
            alt=""
            width="410"
            height="48"
            loading="lazy"
            decoding="async"
          />
          <span class="karensoft-credit__separator">|</span>
          <img
            class="karensoft-credit__wordmark karensoft-credit__wordmark--fa"
            src={`${baseUrl}/assets/images/karensoft/wordmark-fa.png`}
            alt=""
            width="383"
            height="96"
            loading="lazy"
            decoding="async"
          />
        </span>
      </a>
      <span style="display:flex; gap:12px; align-items:center;">
        <a href={`${baseUrl}/fa/`} hreflang="fa">FA</a>
        <span aria-hidden="true">/</span>
        <a href={`${baseUrl}/en/`} hreflang="en">EN</a>
        <span style="margin-inline-start:8px; opacity:0.6;">{lang === 'fa' ? 'شناسه ملی ' : 'ID '}<bdi class="bidi-ltr" dir="ltr">{lang === 'fa' ? '۱۰۸۶۱۴۱۵۲۱۵' : '10861415215'}</bdi></span>
      </span>
    </div>
  </div>
</footer>
