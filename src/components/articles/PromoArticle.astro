---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleDates from './ArticleDates.astro';
import { articleImage } from '../../lib/images';
import { ARTICLE_UPDATED, PROMO_PARTNER_PUBLISHED } from '../../lib/schema';
import type { PromoCopy } from '../../data/articles/types';
import '../../styles/articles.css';

interface Props {
  lang: 'fa' | 'en';
  copy: PromoCopy;
}

const { lang, copy } = Astro.props;
const isFa = lang === 'fa';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (Astro.site?.toString() || 'https://qazvintasvir.ir').replace(/\/$/, '');
const canonical = `${site}${baseUrl}/${lang}/articles/${copy.slug}/`;
const published = PROMO_PARTNER_PUBLISHED;

const hreflang = [
  { lang: 'fa', href: `${site}${baseUrl}/fa/articles/${copy.slug}/` },
  { lang: 'en', href: `${site}${baseUrl}/en/articles/${copy.slug}/` },
  { lang: 'x-default', href: `${site}${baseUrl}/fa/articles/${copy.slug}/` },
];

const coverageAreas = copy.coverage
  ? copy.coverage.groups.flatMap((group) => group.areas.map((area) => area.name))
  : [];

const [heroImage, heroAlt, heroCaption] = copy.hero;
const heroPath = `${baseUrl}${heroImage}`;
const hero = articleImage(heroImage);
const heroSrc = `${baseUrl}${hero.src}`;
const heroSrcSet = hero.srcSet
  ?.split(', ')
  .map((entry) => {
    const [path, width] = entry.split(' ');
    return `${baseUrl}${path} ${width}`;
  })
  .join(', ');
const heroUrl = `${site}${heroPath}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: copy.title,
      description: copy.description,
      inLanguage: lang,
      datePublished: published,
      dateModified: ARTICLE_UPDATED,
      image: [heroUrl],
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
      author: {
        '@type': 'Organization',
        '@id': `${site}${baseUrl}/#organization`,
        name: isFa ? 'شرکت قزوین تصویر' : 'Qazvin Tasvir Company',
        url: `${site}${baseUrl}/${lang}/`,
      },
      publisher: {
        '@type': 'Organization',
        '@id': `${site}${baseUrl}/#organization`,
        name: isFa ? 'شرکت قزوین تصویر' : 'Qazvin Tasvir Company',
        url: site,
        logo: { '@type': 'ImageObject', url: `${site}${baseUrl}/assets/images/brand/qazvin-tasvir-favicon.png`, width: 512, height: 512 },
      },
      articleSection: copy.labels.sectionKicker,
      keywords: copy.keywords,
      about: { '@type': 'Service', '@id': `${site}${baseUrl}/${lang}/services/staff-shuttle/#service`, name: isFa ? 'سرویس ایاب و ذهاب قزوین؛ پرسنل و کارخانه' : 'Staff shuttle service in Qazvin' },
      isAccessibleForFree: true,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: copy.labels.home, item: `${site}${baseUrl}/${lang}/` },
        { '@type': 'ListItem', position: 2, name: copy.labels.articles, item: `${site}${baseUrl}/${lang}/articles/` },
        { '@type': 'ListItem', position: 3, name: copy.title, item: canonical },
      ],
    },
    ...(copy.coverage
      ? [
          {
            '@type': 'Service',
            '@id': `${canonical}#coverage`,
            name: copy.coverage.schemaName,
            serviceType: copy.coverage.schemaName,
            provider: { '@type': 'Organization', '@id': `${site}${baseUrl}/#organization` },
            areaServed: coverageAreas.map((name) => ({ '@type': 'Place', name })),
          },
        ]
      : []),
    {
      '@type': 'FAQPage',
      mainEntity: copy.faqs.map(([question, answer]) => ({
        '@type': 'Question',
        name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer },
      })),
    },
  ],
};
---

<BaseLayout
  lang={lang}
  title={copy.title}
  description={copy.description}
  image={heroUrl}
  imageAlt={heroAlt}
  canonical={canonical}
  hreflang={hreflang}
  schema={schema}
  ogType="article"
  articlePublishedTime={published}
  articleModifiedTime={ARTICLE_UPDATED}
  bodyClass="article-page"
  preloadImage={heroSrc}
  preloadImageType="image/webp"
>
  <article class="service-guide">
    <section class="guide-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label={isFa ? 'مسیر صفحه' : 'Breadcrumb'}>
          <a href={`${baseUrl}/${lang}/`}>{copy.labels.home}</a>
          <span class="breadcrumbs__sep" aria-hidden="true">/</span>
          <a href={`${baseUrl}/${lang}/articles/`}>{copy.labels.articles}</a>
          <span class="breadcrumbs__sep" aria-hidden="true">/</span>
          <span aria-current="page">{copy.labels.current}</span>
        </nav>
        <div class="guide-hero__grid">
          <div class="guide-hero__copy">
            <span class="editorial-eyebrow editorial-eyebrow--article" lang="en" dir="ltr">INSIGHTS &amp; GUIDES</span>
            <span class="guide-eyebrow">{copy.eyebrow}</span>
            <h1>{copy.title}</h1>
            <p class="guide-hero__lead">{copy.lead}</p>
            <ArticleDates lang={lang} published={published} updated={ARTICLE_UPDATED} />
          </div>
          <figure class="guide-cover">
            <img
              src={heroSrc}
              srcset={heroSrcSet}
              sizes="(max-width: 900px) 100vw, 620px"
              alt={heroAlt}
              width={hero.width}
              height={hero.height}
              fetchpriority="high"
              decoding="async"
            />
            <figcaption>{heroCaption}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <div class="container guide-content">
      <section class="guide-answer">
        <div class="guide-answer__mark" aria-hidden="true">i</div>
        <div>
          <h2>{copy.answer[0]}</h2>
          <p>{copy.answer[1]}</p>
        </div>
      </section>

      <nav class="guide-toc" aria-label={copy.tocTitle}>
        <strong>{copy.tocTitle}</strong>
        <ul>
          {copy.toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
        </ul>
      </nav>

      {copy.sections.map((section) => (
        <section id={section.id} class="guide-goods-section">
          <div class="guide-section-heading">
            <span class="guide-kicker">{section.kicker}</span>
            <h2>{section.title}</h2>
          </div>
          {section.intro && <p class="guide-article-intro">{section.intro}</p>}
          {section.table && (
            <div class="guide-table-wrap">
              <table class="guide-table">
                {section.table.caption && <caption>{section.table.caption}</caption>}
                <thead>
                  <tr>{section.table.head.map((cell) => <th scope="col">{cell}</th>)}</tr>
                </thead>
                <tbody>
                  {section.table.rows.map((row) => (
                    <tr>
                      {row.map((cell, index) =>
                        index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>,
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
          {section.cards && section.cards.length > 0 && (
            <div class:list={['guide-overview__grid', section.cards.length === 4 && 'guide-overview__grid--four']}>
              {section.cards.map(([title, text], index) => (
                <article class="guide-overview__item">
                  <span class="guide-overview__number">{String(index + 1).padStart(2, '0')}</span>
                  <h3>{title}</h3>
                  <p>{text}</p>
                </article>
              ))}
            </div>
          )}
          {section.bullets && section.bullets.length > 0 && (
            <ul class="guide-checklist">
              {section.bullets.map((item) => <li>{item}</li>)}
            </ul>
          )}
          {section.note && (
            <aside class="guide-note guide-note--wide">
              <strong>{section.note.title}</strong>
              <p>{section.note.text}</p>
            </aside>
          )}
        </section>
      ))}

      {copy.coverage && (
        <section id="coverage-map" class="guide-goods-section guide-coverage">
          <div class="guide-section-heading">
            <span class="guide-kicker">{copy.coverage.kicker}</span>
            <h2>{copy.coverage.title}</h2>
          </div>
          <p class="guide-article-intro">{copy.coverage.intro}</p>
          <div class="guide-coverage__map">
            {copy.coverage.groups.map((group) => (
              <div class="guide-coverage__group">
                <div class="guide-coverage__group-head">
                  <h3>{group.label}</h3>
                  <p>{group.note}</p>
                </div>
                <ul class="guide-coverage__chips">
                  {group.areas.map((area) => (
                    <li class="guide-coverage__chip">
                      <strong>{area.name}</strong>
                      <span>{area.detail}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <p class="guide-coverage__legend">{copy.coverage.legend}</p>
          {copy.coverage.note && (
            <aside class="guide-note guide-note--wide">
              <strong>{copy.coverage.note.title}</strong>
              <p>{copy.coverage.note.text}</p>
            </aside>
          )}
        </section>
      )}

      <section class="guide-goods-section">
        <div class="guide-section-heading">
          <span class="guide-kicker">{isFa ? 'تصویرهایی از خدمت' : 'Service in context'}</span>
          <h2>{copy.gallery.title}</h2>
        </div>
        <div class="guide-example-grid guide-example-grid--three">
          {copy.gallery.items.map(([image, alt, caption, credit]) => {
            const picture = articleImage(image);
            const srcSet = picture.srcSet
              ?.split(', ')
              .map((entry) => {
                const [path, width] = entry.split(' ');
                return `${baseUrl}${path} ${width}`;
              })
              .join(', ');
            return (
              <figure class="guide-example-card guide-gallery-card">
                <img
                  src={`${baseUrl}${picture.src}`}
                  srcset={srcSet}
                  sizes="(max-width: 640px) 92vw, (max-width: 1024px) 45vw, 360px"
                  alt={alt}
                  width={picture.width}
                  height={picture.height}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>
                  {caption}
                  {credit && <span class="guide-credit" dir="auto">{credit}</span>}
                </figcaption>
              </figure>
            );
          })}
        </div>
      </section>

      <section id="faq" class="guide-faq guide-goods-section">
        <div class="guide-section-heading">
          <span class="guide-kicker">{isFa ? 'پاسخ‌های روشن' : 'Clear answers'}</span>
          <h2>{copy.faqTitle}</h2>
        </div>
        <div class="guide-faq__list">
          {copy.faqs.map(([question, answer]) => (
            <details class="guide-faq__item">
              <summary>{question}</summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </section>

      <p class="guide-disclaimer">{copy.disclaimer}</p>

      <section class="guide-cta">
        <div>
          <span class="guide-kicker">{copy.cta.kicker}</span>
          <h2>{copy.cta.title}</h2>
          <p>{copy.cta.text}</p>
        </div>
        <div class="guide-cta__actions">
          <a class="btn btn--accent" href={`${baseUrl}/${lang}/contact/`}>
            {copy.cta.primary}
            <span aria-hidden="true">{isFa ? ' ←' : ' →'}</span>
          </a>
          <a class="guide-cta__secondary" href={`${baseUrl}/${lang}/services/staff-shuttle/`}>{copy.cta.secondary}</a>
        </div>
      </section>

      <nav class="guide-related" aria-label={copy.relatedTitle}>
        <span class="guide-kicker">{copy.labels.relatedKicker}</span>
        <h2>{copy.relatedTitle}</h2>
        <ul>
          {copy.related.map(([label, href]) => (
            <li><a href={href}>{label}<span aria-hidden="true">{isFa ? ' ←' : ' →'}</span></a></li>
          ))}
        </ul>
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .guide-cover img,
  .guide-gallery-card img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    background: var(--surface-muted, #f4f7fb);
  }
  .guide-cover img {
    aspect-ratio: 3 / 2;
    border-radius: var(--r-md);
  }
  .guide-gallery-card img {
    aspect-ratio: 4 / 3;
  }
  @media (max-width: 900px) {
    .guide-cover img {
      aspect-ratio: 16 / 10;
      max-height: 46vh;
    }
  }
  @media (max-width: 640px) {
    .guide-gallery-card img {
      aspect-ratio: 16 / 10;
      max-height: 40vh;
    }
  }
  .guide-credit {
    display: block;
    margin-block-start: 4px;
    color: var(--text-muted);
    font-size: 0.72rem;
    line-height: 1.6;
  }
  .guide-coverage__map {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
    margin-block: 22px 12px;
  }
  .guide-coverage__group {
    padding: 18px;
    border: 1px solid var(--line-soft);
    border-radius: var(--r-md);
    background: var(--surface-white);
  }
  .guide-coverage__group-head h3 {
    margin: 0 0 4px;
    color: var(--primary-navy);
    font-size: 1.02rem;
  }
  .guide-coverage__group-head p {
    margin: 0 0 14px;
    color: var(--text-muted);
    font-size: 0.86rem;
  }
  .guide-coverage__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .guide-coverage__chip {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 128px;
    padding: 10px 12px;
    border: 1px solid var(--line-soft);
    border-radius: var(--r-sm, 10px);
    background: var(--surface-muted, #f4f7fb);
  }
  .guide-coverage__chip strong {
    color: var(--primary-navy);
    font-size: 0.92rem;
  }
  .guide-coverage__chip span {
    color: var(--text-muted);
    font-size: 0.76rem;
    line-height: 1.6;
  }
  .guide-coverage__legend {
    margin: 0 0 18px;
    color: var(--text-muted);
    font-size: 0.84rem;
  }
  .guide-table-wrap {
    margin-block: 22px 10px;
    overflow-x: auto;
    border: 1px solid var(--line-soft);
    border-radius: var(--r-md);
    background: var(--surface-white);
  }
  .guide-table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 0.95rem;
    line-height: 1.7;
  }
  .guide-table caption {
    padding: 14px 16px 0;
    color: var(--text-muted);
    font-size: 0.85rem;
    text-align: start;
  }
  .guide-table th,
  .guide-table td {
    padding: 12px 16px;
    border-block-end: 1px solid var(--line-soft);
    text-align: start;
    vertical-align: top;
  }
  .guide-table thead th {
    background: var(--surface-muted, #f4f7fb);
    color: var(--primary-navy);
    font-weight: 700;
    white-space: nowrap;
  }
  .guide-table tbody th {
    color: var(--primary-navy);
    font-weight: 700;
    white-space: nowrap;
  }
  .guide-table tbody tr:last-child th,
  .guide-table tbody tr:last-child td {
    border-block-end: 0;
  }
  .guide-table tbody tr:nth-child(even) th,
  .guide-table tbody tr:nth-child(even) td {
    background: var(--surface-soft, #fafbfd);
  }
  .guide-checklist {
    display: grid;
    gap: 10px;
    margin-block: 20px 8px;
    padding: 0;
    list-style: none;
  }
  .guide-checklist li {
    position: relative;
    padding-inline-start: 28px;
    color: var(--text-primary);
    line-height: 1.9;
  }
  .guide-checklist li::before {
    content: '✓';
    position: absolute;
    inset-inline-start: 0;
    color: var(--success);
    font-weight: 700;
  }
  .guide-related {
    margin-block: 40px 56px;
    padding: 28px;
    background: var(--surface-white);
    border: 1px solid var(--line-soft);
    border-radius: var(--r-lg);
  }
  .guide-related h2 {
    margin-block: 6px 16px;
    font-size: 1.15rem;
  }
  .guide-related ul {
    display: grid;
    gap: 10px;
    padding: 0;
    list-style: none;
  }
  .guide-related a {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    border: 1px solid var(--line-soft);
    border-radius: var(--r-md);
    color: var(--text-primary);
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .guide-related a:hover,
  .guide-related a:focus-visible {
    border-color: var(--amber-accent);
    transform: translateY(-1px);
  }
</style>
