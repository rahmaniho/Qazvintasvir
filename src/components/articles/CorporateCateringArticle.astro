const serviceUrl = `${site}${baseUrl}/${lang}/services/personnel-food/`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article', headline: articleTitle, description, inLanguage: lang,
      datePublished: ARTICLE_PUBLISHED, dateModified: ARTICLE_UPDATED,
      image: [heroUrl, `${site}${deliveryPath}`, `${site}${hospitalityPath}`],
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
      author: { '@type': 'Organization', name: isFa ? 'شرکت قزوین تصویر' : 'Qazvin Tasvir Company', url: `${site}${baseUrl}/${lang}/` },
      publisher: { '@type': 'Organization', name: isFa ? 'شرکت قزوین تصویر' : 'Qazvin Tasvir Company', url: site, logo: { '@type': 'ImageObject', url: `${site}${baseUrl}/assets/images/brand/qazvin-tasvir-favicon.png`, width: 512, height: 512 } },
      articleSection: isFa ? 'کترینگ شرکتی و غذای پرسنلی' : 'Corporate catering and staff meals',
      keywords: isFa ? ['غذای پرسنلی قزوین', 'کترینگ شرکتی قزوین', 'غذای سازمانی', 'قیمت غذای پرسنل', 'پذیرایی سازمانی'] : ['staff catering Qazvin', 'corporate catering Qazvin', 'workplace meals', 'employee meal prices', 'organisational hospitality'],
      about: { '@type': 'Service', name: isFa ? 'تأمین غذای پرسنل و وعده‌های سازمانی' : 'Staff meals and corporate catering', url: serviceUrl, provider: { '@type': 'Organization', name: isFa ? 'قزوین تصویر' : 'Qazvin Tasvir Company' } },
      isAccessibleForFree: true,
    },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: copy.home, item: `${site}${baseUrl}/${lang}/` },
      { '@type': 'ListItem', position: 2, name: copy.articles, item: `${site}${baseUrl}/${lang}/articles/` },
      { '@type': 'ListItem', position: 3, name: articleTitle, item: canonical },
    ] },
    { '@type': 'FAQPage', mainEntity: copy.faqs.map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) },
  ],
};
---

<BaseLayout lang={lang} title={articleTitle} description={description} image={heroUrl} imageAlt={copy.heroAlt} canonical={canonical} hreflang={hreflang} schema={schema} ogType="article" bodyClass="article-page" preloadImage={heroPath} preloadImageType="image/jpeg">
  <article class="service-guide">
    <section class="guide-hero"><div class="container">
      <nav class="breadcrumbs" aria-label={isFa ? 'مسیر صفحه' : 'Breadcrumb'}><a href={`${baseUrl}/${lang}/`}>{copy.home}</a><span class="breadcrumbs__sep" aria-hidden="true">/</span><a href={`${baseUrl}/${lang}/articles/`}>{copy.articles}</a><span class="breadcrumbs__sep" aria-hidden="true">/</span><span aria-current="page">{copy.current}</span></nav>
      <div class="guide-hero__grid"><div class="guide-hero__copy"><span class="editorial-eyebrow editorial-eyebrow--article" lang="en" dir="ltr">INSIGHTS &amp; GUIDES</span>
            <span class="guide-eyebrow">{copy.eyebrow}</span><h1>{articleTitle}</h1><p class="guide-hero__lead">{copy.lead}</p><ArticleDates lang={lang} published={ARTICLE_PUBLISHED} updated={ARTICLE_UPDATED} /></div>
        <figure class="guide-cover"><img src={heroPath} alt={copy.heroAlt} width="1360" height="768" fetchpriority="high" decoding="async"/><figcaption>{copy.heroCaption}</figcaption></figure>
      </div>
    </div></section>
    <div class="container guide-content">
      <section class="guide-answer"><div class="guide-answer__mark" aria-hidden="true">i</div><div><h2>{copy.answerTitle}</h2><p>{copy.answer}</p></div></section>
      <nav class="guide-toc" aria-label={copy.tocTitle}><strong>{copy.tocTitle}</strong><ul>{copy.toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ul></nav>

      <section id="services" class="guide-goods-section"><div class="guide-section-heading"><span class="guide-kicker">{isFa ? 'مدل‌های سفارش' : 'Service types'}</span><h2>{copy.servicesTitle}</h2></div><p class="guide-article-intro">{copy.servicesIntro}</p><div class="guide-overview__grid">{copy.services.map(([title, text], index) => <article class="guide-overview__item"><span class="guide-overview__number">{isFa ? ['۰۱','۰۲','۰۳'][index] : `0${index + 1}`}</span><h3>{title}</h3><p>{text}</p></article>)}</div></section>

      <section id="planning" class="guide-goods-section"><div class="guide-section-heading"><span class="guide-kicker">{isFa ? 'برنامه‌ی وعده‌ها' : 'Meal planning'}</span><h2>{copy.mealTitle}</h2></div><p class="guide-article-intro">{copy.mealText}</p><aside class="guide-note guide-note--wide"><strong>{isFa ? 'حداقل سفارش درج‌شده در سایت' : 'Minimum shown on the service page'}</strong><p>{copy.mealNote}</p></aside></section>

      <section id="hospitality" class="guide-goods-section"><div class="guide-section-heading"><span class="guide-kicker">{isFa ? 'پذیرایی سازمانی' : 'Corporate hospitality'}</span><h2>{copy.hospitalityTitle}</h2></div><p class="guide-article-intro">{copy.hospitalityText}</p><aside class="guide-caution">{copy.hospitalityNote}</aside></section>

      <section class="guide-goods-section"><div class="guide-section-heading"><span class="guide-kicker">{isFa ? 'تصاویر خدمات' : 'Service imagery'}</span><h2>{copy.galleryTitle}</h2></div><div class="guide-example-grid guide-example-grid--three">{copy.gallery.map(([image, alt, caption]) => <figure class="guide-example-card guide-gallery-card"><img src={image} alt={alt} width="1200" height="800" loading="lazy" decoding="async"/><figcaption>{caption}</figcaption></figure>)}</div></section>

      <section id="price" class="guide-goods-section"><div class="guide-section-heading"><span class="guide-kicker">{isFa ? 'قیمت و برآورد' : 'Pricing and estimates'}</span><h2>{copy.priceTitle}</h2></div><p class="guide-article-intro">{copy.priceIntro}</p><div class="guide-overview__grid guide-overview__grid--four">{copy.priceFactors.map(([title, text], index) => <article class="guide-overview__item"><span class="guide-overview__number">{isFa ? ['۰۱','۰۲','۰۳','۰۴','۰۵'][index] : `0${index + 1}`}</span><h3>{title}</h3><p>{text}</p></article>)}</div><aside class="guide-assurance"><div class="guide-assurance__icon" aria-hidden="true">✓</div><div><h2>{copy.compareTitle}</h2><p>{copy.compareText}</p></div></aside></section>

      <section id="quality" class="guide-goods-section"><div class="guide-section-heading"><span class="guide-kicker">{isFa ? 'کیفیت و هماهنگی' : 'Quality and coordination'}</span><h2>{copy.qualityTitle}</h2></div><ol class="guide-steps">{copy.quality.map(([title, text], index) => <li><span class="guide-step__number">{isFa ? ['۰۱','۰۲','۰۳','۰۴','۰۵'][index] : `0${index + 1}`}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol></section>

      <section id="faq" class="guide-faq guide-goods-section"><div class="guide-section-heading"><span class="guide-kicker">{isFa ? 'پاسخ‌های روشن' : 'Clear answers'}</span><h2>{copy.faqTitle}</h2></div><div class="guide-faq__list">{copy.faqs.map(([question, answer]) => <details class="guide-faq__item"><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
      <p class="guide-disclaimer">{copy.disclaimer}</p>
      <section class="guide-cta"><div><span class="guide-kicker">{isFa ? 'کترینگ قزوین تصویر' : 'Qazvin Tasvir catering'}</span><h2>{copy.ctaTitle}</h2><p>{copy.ctaText}</p></div><div class="guide-cta__actions"><a class="btn btn--accent" href={`${baseUrl}/${lang}/contact/`}>{copy.ctaContact}<span aria-hidden="true">{isFa ? ' ←' : ' →'}</span></a><a class="guide-cta__secondary" href={`${baseUrl}/${lang}/services/personnel-food/`}>{copy.ctaService}</a></div></section>
    </div>
  </article>
</BaseLayout>
