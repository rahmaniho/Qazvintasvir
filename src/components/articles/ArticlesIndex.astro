---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/articles.css';

interface Props { lang: 'fa' | 'en' }
const { lang } = Astro.props;
const isFa = lang === 'fa';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (Astro.site?.toString() || 'https://qazvintasvir.ir').replace(/\/$/, '');
const canonical = `${site}${baseUrl}/${lang}/articles/`;

const fa = {
  title: 'مقاله‌ها و راهنماهای قزوین تصویر',
  description: 'راهنماهای کاربردی درباره‌ی خدمات بازرگانی، سرویس ایاب‌وذهاب صنعتی، غذای پرسنلی و پشتیبانی سازمانی در قزوین.',
  breadcrumbHome: 'خانه',
  breadcrumbCurrent: 'مقاله‌ها',
  heading: 'مقاله‌ها و راهنماها',
  intro: 'دانش کاربردی، راهنماهای تخصصی و اطلاعات موردنیاز برای تصمیم‌گیری بهتر در حوزه‌ی خدمات سازمانی، بازرگانی و ترابری.',
  focusTitle: 'موضوع‌های این بخش',
  focusItems: ['بازرگانی و ضوابط تجارت', 'ترابری سازمانی و صنعتی', 'غذای پرسنلی و خدمات سازمانی'],
  featuredLabel: 'راهنمای منتخب',
  featuredRead: 'مطالعه‌ی راهنما',
  listEyebrow: 'از بازرگانی تا محیط کار',
  listTitle: 'همه‌ی مقاله‌ها',
  read: 'مطالعه‌ی مقاله',
  noteTitle: 'اطلاعات، پیش از تصمیم',
  note: 'هر درخواست با توجه به مشخصات کالا یا خدمت، مسیر، زمان و مدارک بررسی می‌شود. شرایط نهایی پس از شناخت نیاز مجموعه روشن خواهد شد.',
};
const en = {
  title: 'Articles & Guides | Qazvin Tasvir',
  description: 'Practical guides to Qazvin Tasvir’s trade, factory transport, staff catering and corporate services in Qazvin.',
  breadcrumbHome: 'Home',
  breadcrumbCurrent: 'Articles',
  heading: 'Articles & Guides',
  intro: 'Practical knowledge and specialist guides to support better decisions across corporate services, trade and transport.',
  focusTitle: 'Editorial focus',
  focusItems: ['Trade and regulations', 'Corporate and industrial transport', 'Staff meals and workplace services'],
  featuredLabel: 'Featured guide',
  featuredRead: 'Read the guide',
  listEyebrow: 'From trade to the workplace',
  listTitle: 'All articles',
  read: 'Read article',
  noteTitle: 'Information before a decision',
  note: 'Each request is reviewed against the goods or service, route, timing and available documents. Terms are clarified after the organisation’s needs are understood.',
};
const copy = isFa ? fa : en;

// The service guide is the broadest evergreen introduction to the company's actual service areas.
const articles = isFa ? [
  {
    slug: 'services-guide',
    href: `${baseUrl}/${lang}/articles/services-guide/`,
    image: `${baseUrl}/assets/img/articles/services-guide-hero.jpg`,
    alt: 'تصویر مفهومی هماهنگی عملیات بازرگانی و خدمات سازمانی',
    category: 'راهنمای جامع خدمات',
    title: 'خدمات قزوین تصویر چیست؟ راهنمای جامع بازرگانی، ترابری و پشتیبانی سازمانی',
    summary: 'هشت مسیر خدمت قزوین تصویر را در سه حوزه‌ی بازرگانی و تأمین، ترابری سازمانی و پشتیبانی محل کار بشناسید؛ همراه با نکات کاربردی برای شروع گفت‌وگو.',
  },
  {
    slug: 'permitted-goods-trade',
    href: `${baseUrl}/${lang}/articles/permitted-goods-trade/`,
    image: `${baseUrl}/assets/img/articles/permitted-goods-hero.jpg`,
    alt: 'کارشناس بازرگانی در حال بررسی نمونه‌ی کالا و اسناد پیش از حمل بین‌المللی',
    category: 'راهنمای مقررات واردات و صادرات',
    title: 'چه کالاهایی برای بازرگانی مجازند؟ راهنمای تشخیص واردات و صادرات',
    summary: 'تفاوت کالای مجاز، مشروط و ممنوع را بشناسید و پیش از معامله، کد تعرفه، ضوابط روز و مجوزهای احتمالی را چگونه بررسی کنید.',
  },
  {
    slug: 'factory-staff-transport-qazvin',
    href: `${baseUrl}/${lang}/articles/factory-staff-transport-qazvin/`,
    image: `${baseUrl}/assets/img/articles/industrial-shuttle-hero.jpg`,
    alt: 'اتوبوس سرویس پرسنل در ورودی یک مجموعه‌ی صنعتی در آغاز شیفت کاری',
    category: 'راهنمای سرویس ایاب‌وذهاب صنعتی',
    title: 'بهترین سرویس ایاب‌وذهاب صنعتی در قزوین و حومه؟ راهنمای انتخاب و قیمت',
    summary: 'معیارهای انتخاب سرویس شیفتی، مسیرسنجی کارخانه، ناوگان اتوبوس و مینی‌بوس و عوامل مؤثر بر قیمت قرارداد را بخوانید.',
  },
  {
    slug: 'corporate-catering-qazvin',
    href: `${baseUrl}/${lang}/articles/corporate-catering-qazvin/`,
    image: `${baseUrl}/assets/img/articles/corporate-catering-hero.jpg`,
    alt: 'آشپزهای حرفه‌ای در حال آماده‌سازی وعده‌های غذایی برای پذیرایی و غذای سازمانی',
    category: 'راهنمای غذای سازمانی و پذیرایی',
    title: 'غذای پرسنلی، کترینگ شرکتی و پذیرایی سازمانی در قزوین؛ راهنمای خدمات و قیمت',
    summary: 'از منوی چرخشی و وعده‌های شیفتی تا پذیرایی سازمانی و معیارهای مقایسه‌ی قیمت کترینگ در قزوین.',
  },
] : [
  {
    slug: 'services-guide',
    href: `${baseUrl}/${lang}/articles/services-guide/`,
    image: `${baseUrl}/assets/img/articles/services-guide-hero.jpg`,
    alt: 'Illustrative image of trade operations and corporate services coordination',
    category: 'Complete service guide',
    title: 'What Does Qazvin Tasvir Do? A Guide to Trade, Transport and Corporate Services',
    summary: 'Explore Qazvin Tasvir’s eight service paths across trade and sourcing, organisational transport and workplace support—with practical notes for starting a discussion.',
  },
  {
    slug: 'permitted-goods-trade',
    href: `${baseUrl}/${lang}/articles/permitted-goods-trade/`,
    image: `${baseUrl}/assets/img/articles/permitted-goods-hero.jpg`,
    alt: 'Trade specialist reviewing a product sample and documents before an international shipment',
    category: 'Import and export regulations guide',
    title: 'Which Goods Are Permitted for Trade? A Guide to Import and Export Checks',
    summary: 'Understand permitted, conditional and prohibited goods, and how to check tariff classification, current rules and required approvals before trading.',
  },
  {
    slug: 'factory-staff-transport-qazvin',
    href: `${baseUrl}/${lang}/articles/factory-staff-transport-qazvin/`,
    image: `${baseUrl}/assets/img/articles/industrial-shuttle-hero.jpg`,
    alt: 'Staff shuttle bus at the entrance of an industrial workplace at shift change',
    category: 'Industrial staff transport guide',
    title: 'Best Industrial Staff Transport in Qazvin? A Guide to Shuttle Services and Prices',
    summary: 'Compare shift shuttle options, route planning, bus and minibus fleets, and the factors that shape factory transport contracts.',
  },
  {
    slug: 'corporate-catering-qazvin',
    href: `${baseUrl}/${lang}/articles/corporate-catering-qazvin/`,
    image: `${baseUrl}/assets/img/articles/corporate-catering-hero.jpg`,
    alt: 'Professional kitchen team preparing meals for workplace catering',
    category: 'Workplace meals and hospitality guide',
    title: 'Corporate Catering and Staff Meals in Qazvin: Services, Event Hospitality and Pricing',
    summary: 'Explore rotating menus, shift meals, organisational hospitality and practical ways to compare catering prices in Qazvin.',
  },
];

const featured = articles[0];
const otherArticles = articles.slice(1);
const hreflang = [
  { lang: 'fa', href: `${site}${baseUrl}/fa/articles/` },
  { lang: 'en', href: `${site}${baseUrl}/en/articles/` },
  { lang: 'x-default', href: `${site}${baseUrl}/fa/articles/` },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: copy.title,
  description: copy.description,
  inLanguage: lang,
  url: canonical,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: articles.map((article, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: article.title,
      url: `${site}${article.href}`,
    })),
  },
};
---

<BaseLayout lang={lang} title={copy.title} description={copy.description} image={`${site}${featured.image}`} imageAlt={featured.alt} canonical={canonical} hreflang={hreflang} schema={schema} bodyClass="articles-index" preloadImage={featured.image} preloadImageType="image/jpeg">
  <section class="editorial-hero" aria-labelledby="articles-heading">
    <div class="container editorial-hero__container">
      <nav class="editorial-breadcrumbs" aria-label={isFa ? 'مسیر صفحه' : 'Breadcrumb'}>
        <a href={`${baseUrl}/${lang}/`}>{copy.breadcrumbHome}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{copy.breadcrumbCurrent}</span>
      </nav>

      <div class="editorial-hero__layout">
        <div class="editorial-hero__copy">
          <span class="editorial-eyebrow" lang="en" dir="ltr">INSIGHTS &amp; GUIDES</span>
          <h1 id="articles-heading">{copy.heading}</h1>
          <p>{copy.intro}</p>
        </div>

        <aside class="editorial-focus" aria-label={copy.focusTitle}>
          <span class="editorial-focus__label">{copy.focusTitle}</span>
          <ul>
            {copy.focusItems.map((item) => <li>{item}</li>)}
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="container editorial-content" aria-label={copy.listTitle}>
    <article class="editorial-feature" aria-labelledby="featured-article-title">
      <div class="editorial-feature__body">
        <div class="editorial-feature__meta">
          <span class="editorial-feature__badge">{copy.featuredLabel}</span>
          <span class="editorial-category">{featured.category}</span>
        </div>
        <h2 id="featured-article-title"><a href={featured.href}>{featured.title}</a></h2>
        <p class="editorial-feature__summary">{featured.summary}</p>
        <a class="editorial-read-link" href={featured.href}>
          {copy.featuredRead}
          <span aria-hidden="true">{isFa ? '←' : '→'}</span>
        </a>
      </div>
      <a class="editorial-feature__media" href={featured.href} aria-label={`${copy.featuredRead}: ${featured.title}`}>
        <img src={featured.image} alt={featured.alt} width="1200" height="800" loading="eager" fetchpriority="high" decoding="async" />
      </a>
    </article>

    <section class="editorial-list" aria-labelledby="articles-list-heading">
      <header class="editorial-list__heading">
        <div>
          <span class="editorial-list__eyebrow">{copy.listEyebrow}</span>
          <h2 id="articles-list-heading">{copy.listTitle}</h2>
        </div>
      </header>

      <div class="editorial-card-grid">
        {otherArticles.map((article) => <article class="editorial-card">
          <a class="editorial-card__media" href={article.href} aria-label={`${copy.read}: ${article.title}`}>
            <img src={article.image} alt={article.alt} width="1200" height="800" loading="lazy" decoding="async" />
          </a>
          <div class="editorial-card__body">
            <span class="editorial-category">{article.category}</span>
            <h3><a href={article.href}>{article.title}</a></h3>
            <p>{article.summary}</p>
            <a class="editorial-read-link" href={article.href}>
              {copy.read}
              <span aria-hidden="true">{isFa ? '←' : '→'}</span>
            </a>
          </div>
        </article>)}
      </div>
    </section>

    <aside class="editorial-note">
      <strong>{copy.noteTitle}</strong>
      <p>{copy.note}</p>
    </aside>
  </section>
</BaseLayout>
