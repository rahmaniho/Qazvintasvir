  fleetCards: [
    ['اتوبوس', 'برای مسیرهایی با تعداد مسافر بیشتر یا جابه‌جایی گروهی؛ ظرفیت و امکان توقف در محل سوارشدن باید بررسی شود.'],
    ['مینی‌بوس', 'برای گروه‌های متوسط یا مسیرهایی که دسترسی و انعطاف‌پذیری بیشتری می‌خواهند؛ برنامه و ظرفیت هر مسیر جداگانه سنجیده شود.'],
    ['ون', 'برای گروه‌های کوچک‌تر یا مسیرهای پراکنده؛ تعداد خودروها و هماهنگی زمان حرکت در برآورد نهایی اثر دارد.'],
