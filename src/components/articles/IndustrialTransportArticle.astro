    ['Which vehicles does Qazvin Tasvir list for factory transport?', 'The factory staff transport page lists buses, minibuses and vans. Vehicle type and quantity are determined for each route after passenger numbers and site access are reviewed.'],
    ['Does the service reach every industrial estate and suburb of Qazvin?', 'Coverage needs to be checked against the factory address and employee origins. Share the estate or area, access gate and shift times; coverage should not be assumed to be identical for every location.'],
    ['How much does employee shuttle service cost?', 'Price depends on routes and distance, stops, shifts, fleet size and contract duration. Provide a route map and shift schedule for an estimate; this guide does not publish a flat public rate.'],
    ['What information is needed for an accurate quote?', 'Prepare employee numbers per shift, origins and destinations, working days, departure and return times, contract length and any site-access limits.'],
    ['How can I compare two quotes fairly?', 'Check that each proposal states the same routes, times, vehicle type and number, service term, included costs, responsibilities and process for handling changes.'],
  ],
  disclaimer: 'Images are illustrative. Route coverage, fleet size, schedules and price are determined after reviewing the organisation’s actual requirements; this article does not promise service to every location or the lowest market rate.',
  ctaTitle: 'Request a route-specific proposal for your factory',
  ctaText: 'Prepare the shift schedule and list of pick-up points and destinations so Qazvin Tasvir can review your staff shuttle request.',
  ctaContact: 'Request a route review', ctaService: 'Factory staff transport details',
};

const serviceUrl = `${site}${baseUrl}/${lang}/services/factory-transport/`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article', headline: articleTitle, description, inLanguage: lang,
      datePublished: ARTICLE_PUBLISHED, dateModified: ARTICLE_UPDATED,
      image: [heroUrl, `${site}${minibusPath}`, `${site}${planningPath}`],
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
      author: { '@type': 'Organization', '@id': `${site}${baseUrl}/#organization`, name: isFa ? 'شرکت قزوین تصویر' : 'Qazvin Tasvir Company', url: `${site}${baseUrl}/${lang}/` },
      publisher: { '@type': 'Organization', '@id': `${site}${baseUrl}/#organization`, name: isFa ? 'شرکت قزوین تصویر' : 'Qazvin Tasvir Company', url: site, logo: { '@type': 'ImageObject', url: `${site}${baseUrl}/assets/images/brand/qazvin-tasvir-favicon.png`, width: 512, height: 512 } },
      articleSection: isFa ? 'ترابری صنعتی و سرویس ایاب‌وذهاب' : 'Industrial transport and staff shuttles',
      keywords: isFa ? ['سرویس ایاب و ذهاب کارخانه قزوین', 'قیمت سرویس پرسنل قزوین', 'ترابری شهرک صنعتی قزوین', 'سرویس شیفتی کارکنان'] : ['factory staff transport Qazvin', 'employee shuttle price Qazvin', 'industrial estate shuttle', 'shift transport service'],
      about: { '@type': 'Service', name: isFa ? 'ترابری پرسنل کارخانجات' : 'Factory staff transportation', url: serviceUrl, provider: { '@type': 'Organization', name: isFa ? 'قزوین تصویر' : 'Qazvin Tasvir Company' } },
      isAccessibleForFree: true,
    },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: copy.home, item: `${site}${baseUrl}/${lang}/` },
      { '@type': 'ListItem', position: 2, name: copy.articles, item: `${site}${baseUrl}/${lang}/articles/` },
      { '@type': 'ListItem', position: 3, name: articleTitle, item: canonical },
    ] },
    { '@type': 'FAQPage', mainEntity: copy.faqs.map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) },
  ],
};
---

<BaseLayout lang={lang} title={articleTitle} description={description} image={heroUrl} imageAlt={copy.heroAlt} canonical={canonical} hreflang={hrefs[lang]} schema={schema} ogType="article" articlePublishedTime={ARTICLE_PUBLISHED} articleModifiedTime={ARTICLE_UPDATED} bodyClass="article-page" preloadImage={heroPath} preloadImageType="image/jpeg">
  <article class="service-guide">
    <section class="guide-hero"><div class="container">
      <nav class="breadcrumbs" aria-label={isFa ? 'مسیر صفحه' : 'Breadcrumb'}><a href={`${baseUrl}/${lang}/`}>{copy.home}</a><span class="breadcrumbs__sep" aria-hidden="true">/</span><a href={`${baseUrl}/${lang}/articles/`}>{copy.articles}</a><span class="breadcrumbs__sep" aria-hidden="true">/</span><span aria-current="page">{copy.current}</span></nav>
      <div class="guide-hero__grid"><div class="guide-hero__copy"><span class="editorial-eyebrow editorial-eyebrow--article" lang="en" dir="ltr">INSIGHTS &amp; GUIDES</span>
            <span class="guide-eyebrow">{copy.eyebrow}</span><h1>{articleTitle}</h1><p class="guide-hero__lead">{copy.lead}</p><ArticleDates lang={lang} published={ARTICLE_PUBLISHED} updated={ARTICLE_UPDATED} /></div>
        <figure class="guide-cover"><img src={heroPath} alt={copy.heroAlt} width="1360" height="768" fetchpriority="high" decoding="async"/><figcaption>{copy.heroCaption}</figcaption></figure>
      </div>
    </div></section>
    <div class="container guide-content">
      <section class="guide-answer"><div class="guide-answer__mark" aria-hidden="true">i</div><div><h2>{copy.answerTitle}</h2><p>{copy.answer}</p></div></section>
      <nav class="guide-toc" aria-label={copy.tocTitle}><strong>{copy.tocTitle}</strong><ul>{copy.toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ul></nav>

      <section id="fit" class="guide-goods-section"><div class="guide-section-heading"><span class="guide-kicker">{isFa ? 'معیارهای انتخاب' : 'Selection criteria'}</span><h2>{copy.fitTitle}</h2></div><p class="guide-article-intro">{copy.fitLead}</p>
        <div class="guide-overview__grid guide-overview__grid--four">{copy.criteria.map(([title, text], index) => <article class="guide-overview__item"><span class="guide-overview__number">{isFa ? ['۰۱','۰۲','۰۳','۰۴'][index] : `0${index + 1}`}</span><h3>{title}</h3><p>{text}</p></article>)}</div>
      </section>

      <section id="coverage" class="guide-goods-section"><div class="guide-section-heading"><span class="guide-kicker">{isFa ? 'قزوین و پیرامون' : 'Qazvin and nearby areas'}</span><h2>{copy.coverageTitle}</h2></div><p class="guide-article-intro">{copy.coverageText}</p><aside class="guide-note guide-note--wide"><strong>{isFa ? 'برای بررسی سریع‌تر' : 'For a faster review'}</strong><p>{copy.coverageNote}</p></aside></section>

      <section id="fleet" class="guide-goods-section"><div class="guide-section-heading"><span class="guide-kicker">{isFa ? 'ناوگان متناسب' : 'A suitable fleet'}</span><h2>{copy.fleetTitle}</h2></div><p class="guide-article-intro">{copy.fleetIntro}</p><div class="guide-overview__grid">{copy.fleetCards.map(([title, text], index) => <article class="guide-overview__item"><span class="guide-overview__number">{isFa ? ['۰۱','۰۲','۰۳'][index] : `0${index + 1}`}</span><h3>{title}</h3><p>{text}</p></article>)}</div><p class="guide-caution">{copy.fleetNote}</p></section>

      <section class="guide-goods-section"><div class="guide-section-heading"><span class="guide-kicker">{isFa ? 'تصویرهایی از خدمت' : 'Service in context'}</span><h2>{copy.galleryTitle}</h2></div><div class="guide-example-grid guide-example-grid--three">{copy.gallery.map(([image, alt, caption]) => <figure class="guide-example-card guide-gallery-card"><img src={image} alt={alt} width="1200" height="800" loading="lazy" decoding="async"/><figcaption>{caption}</figcaption></figure>)}</div></section>

      <section id="price" class="guide-goods-section"><div class="guide-section-heading"><span class="guide-kicker">{isFa ? 'برآورد منصفانه' : 'A fair estimate'}</span><h2>{copy.priceTitle}</h2></div><p class="guide-article-intro">{copy.priceIntro}</p><div class="guide-overview__grid guide-overview__grid--four">{copy.priceFactors.map(([title, text], index) => <article class="guide-overview__item"><span class="guide-overview__number">{isFa ? ['۰۱','۰۲','۰۳','۰۴','۰۵'][index] : `0${index + 1}`}</span><h3>{title}</h3><p>{text}</p></article>)}</div><aside class="guide-assurance"><div class="guide-assurance__icon" aria-hidden="true">✓</div><div><h2>{copy.priceValueTitle}</h2><p>{copy.priceValue}</p></div></aside></section>

      <section id="workflow" class="guide-goods-section"><div class="guide-section-heading"><span class="guide-kicker">{isFa ? 'از درخواست تا اجرا' : 'From request to operation'}</span><h2>{copy.workflowTitle}</h2></div><ol class="guide-steps">{copy.steps.map(([title, text], index) => <li><span class="guide-step__number">{isFa ? ['۰۱','۰۲','۰۳','۰۴'][index] : `0${index + 1}`}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol></section>

      <section id="faq" class="guide-faq guide-goods-section"><div class="guide-section-heading"><span class="guide-kicker">{isFa ? 'پاسخ‌های روشن' : 'Clear answers'}</span><h2>{copy.faqTitle}</h2></div><div class="guide-faq__list">{copy.faqs.map(([question, answer]) => <details class="guide-faq__item"><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
      <p class="guide-disclaimer">{copy.disclaimer}</p>
      <section class="guide-cta"><div><span class="guide-kicker">{isFa ? 'ترابری صنعتی قزوین تصویر' : 'Qazvin Tasvir industrial transport'}</span><h2>{copy.ctaTitle}</h2><p>{copy.ctaText}</p></div><div class="guide-cta__actions"><a class="btn btn--accent" href={`${baseUrl}/${lang}/contact/`}>{copy.ctaContact}<span aria-hidden="true">{isFa ? ' ←' : ' →'}</span></a><a class="guide-cta__secondary" href={`${baseUrl}/${lang}/services/factory-transport/`}>{copy.ctaService}</a></div></section>
    </div>
  </article>
</BaseLayout>
