    { lang: 'en', href: `${site}${baseUrl}/en/articles/${slug}/` },
    { lang: 'x-default', href: `${site}${baseUrl}/fa/articles/${slug}/` },
  ],
  en: [
    { lang: 'fa', href: `${site}${baseUrl}/fa/articles/${slug}/` },
    { lang: 'en', href: `${site}${baseUrl}/en/articles/${slug}/` },
    { lang: 'x-default', href: `${site}${baseUrl}/fa/articles/${slug}/` },
  ],
};
const copy = isFa ? {
  home: 'خانه', articles: 'مقاله‌ها', current: 'سرویس ایاب‌وذهاب صنعتی در قزوین',
