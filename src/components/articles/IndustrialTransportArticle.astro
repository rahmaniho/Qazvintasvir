---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ARTICLE_PUBLISHED, ARTICLE_UPDATED } from '../../lib/schema';
import ArticleDates from './ArticleDates.astro';
import '../../styles/articles.css';

interface Props { lang: 'fa' | 'en' }
const { lang } = Astro.props;
const isFa = lang === 'fa';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (Astro.site?.toString() || 'https://qazvintasvir.ir').replace(/\/$/, '');
const slug = 'factory-staff-transport-qazvin';
const canonical = `${site}${baseUrl}/${lang}/articles/${slug}/`;
const heroPath = `${baseUrl}/assets/img/articles/industrial-shuttle-hero.jpg`;
const heroUrl = `${site}${heroPath}`;
const minibusPath = `${baseUrl}/assets/img/articles/industrial-shuttle-minibus.jpg`;
const planningPath = `${baseUrl}/assets/img/articles/industrial-shuttle-planning.jpg`;
const articleTitle = isFa
  ? 'سرویس ایاب‌وذهاب صنعتی قزوین؛ راهنمای انتخاب و قیمت'
  : 'Industrial Staff Transport in Qazvin: Guide and Prices';
const description = isFa
  ? 'راهنمای انتخاب سرویس ایاب‌وذهاب کارخانه در قزوین و حومه؛ مسیر شیفت، اتوبوس و مینی‌بوس، ایمنی، پشتیبانی و عوامل مؤثر بر قیمت قرارداد.'
