---
interface Props {
  lang: 'fa' | 'en';
  services: Array<{ slug: string; title: string; summary: string; href: string }>;
  currentPath: string;
  baseUrl: string;
}
const { lang, services, currentPath, baseUrl } = Astro.props;
const labels = lang === 'fa'
  ? { viewAll: 'مشاهدهٔ همهٔ خدمات →', services: 'خدمات' }
  : { viewAll: 'View all services →', services: 'Services' };
const isActive = services.some((service) => currentPath.includes(service.slug));
---

<div class="nav-menu__item" data-mega>
  <button
    type="button"
    class:list={["nav-menu__link", "nav-menu__link--has-dd", isActive ? "is-active" : ""]}
    aria-expanded="false"
    aria-controls="services-menu"
    aria-haspopup="true"
  >
    {labels.services}
  </button>
  <div id="services-menu" class="mega-menu" hidden>
    <div class="mega-menu__grid">
      {services.map((service) => (
        <a
          href={service.href}
          class="mega-menu__link"
          aria-current={currentPath.includes(service.slug) ? 'page' : undefined}
        >
          <span class="mega-menu__icon" aria-hidden="true">◆</span>
          <span class="mega-menu__text">
            <strong>{service.title}</strong>
            <span>{service.summary}</span>
          </span>
        </a>
      ))}
    </div>
    <div class="mega-menu__footer">
      <a href={`${baseUrl}/${lang}/services/`} class="mega-menu__cta">{labels.viewAll}</a>
    </div>
  </div>
</div>

<script>
  const megaItems = document.querySelectorAll<HTMLElement>('[data-mega]');

  megaItems.forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>('button[aria-controls]');
    const panel = item.querySelector<HTMLDivElement>('.mega-menu');
    if (!trigger || !panel) return;

    const setOpen = (open: boolean) => {
      trigger.setAttribute('aria-expanded', String(open));
      item.classList.toggle('is-open', open);
      panel.hidden = !open;
    };

    trigger.addEventListener('click', () => setOpen(panel.getAttribute('hidden') !== null));
    trigger.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        setOpen(false);
        trigger.focus();
      } else if (event.key === 'ArrowDown') {
        event.preventDefault();
        setOpen(true);
        panel.querySelector<HTMLAnchorElement>('a[href]')?.focus();
      }
    });

    const links = Array.from(panel.querySelectorAll<HTMLAnchorElement>('a[href]'));
    panel.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        setOpen(false);
        trigger.focus();
        return;
      }
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      const activeIndex = links.indexOf(document.activeElement as HTMLAnchorElement);
      if (activeIndex < 0 || links.length === 0) return;
      event.preventDefault();
      const step = event.key === 'ArrowDown' ? 1 : -1;
      links[(activeIndex + step + links.length) % links.length]?.focus();
    });

    item.addEventListener('mouseenter', () => {
      if (window.matchMedia('(min-width: 1024px)').matches) setOpen(true);
    });
    item.addEventListener('mouseleave', () => {
      if (window.matchMedia('(min-width: 1024px)').matches && !item.contains(document.activeElement)) {
        setOpen(false);
      }
    });
    item.addEventListener('focusout', (event: FocusEvent) => {
      const next = event.relatedTarget;
      if (next instanceof Node && item.contains(next)) return;
      setOpen(false);
    });
  });

  document.addEventListener('click', (event: MouseEvent) => {
    const target = event.target;
    if (!(target instanceof Node)) return;
    megaItems.forEach((item) => {
      if (item.contains(target)) return;
      const trigger = item.querySelector<HTMLButtonElement>('button[aria-controls]');
      const panel = item.querySelector<HTMLDivElement>('.mega-menu');
      if (trigger && panel && !panel.hidden) {
        trigger.setAttribute('aria-expanded', 'false');
        item.classList.remove('is-open');
        panel.hidden = true;
      }
    });
  });
</script>
