---
interface Props {
  lang: 'fa' | 'en';
  navLinks: Array<{ href: string; label: string; current?: boolean }>;
  serviceLinks: Array<{ href: string; label: string; current?: boolean }>;
  baseUrl: string;
}
const { lang, navLinks, serviceLinks, baseUrl } = Astro.props;
const labels = lang === 'fa'
  ? { close: 'بستن منو', services: 'خدمات', viewAll: 'فهرست همهٔ خدمات', contact: 'درخواست مشاوره' }
  : { close: 'Close menu', services: 'Services', viewAll: 'All services', contact: 'Request consultation' };
const ctaHref = `${baseUrl}/${lang}/contact/`;
---

<div
  class="mobile-drawer"
  id="mobile-drawer"
  hidden
  role="dialog"
  aria-modal="true"
  aria-label={lang === 'fa' ? 'منوی موبایل' : 'Mobile navigation'}
>
  <div class="mobile-drawer__backdrop" data-close-drawer></div>
  <div class="mobile-drawer__panel" role="document">
    <div class="mobile-drawer__head">
      <span class="mobile-drawer__brand">{lang === 'fa' ? 'قزوین تصویر' : 'Qazvin Tasvir'}</span>
      <button type="button" class="mobile-drawer__close" aria-label={labels.close} data-close-drawer>
        <span aria-hidden="true">✕</span>
      </button>
    </div>

    <nav class="mobile-drawer__nav" aria-label={lang === 'fa' ? 'ناوبری موبایل' : 'Mobile navigation'}>
      {navLinks.map((link) => (
        <a href={link.href} class="mobile-drawer__link" aria-current={link.current ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
      <details>
        <summary>{labels.services}</summary>
        <div class="mobile-drawer__sub">
          <a href={`${baseUrl}/${lang}/services/`}>{labels.viewAll}</a>
          {serviceLinks.map((service) => (
            <a href={service.href} aria-current={service.current ? 'page' : undefined}>{service.label}</a>
          ))}
        </div>
      </details>
    </nav>

    <div class="mobile-drawer__foot">
      <a href={ctaHref} class="btn btn--accent mobile-drawer__cta">{labels.contact}</a>
      <div class="mobile-drawer__languages" aria-label={lang === 'fa' ? 'انتخاب زبان' : 'Choose language'}>
        <a href={`${baseUrl}/fa/`} aria-current={lang === 'fa' ? 'page' : undefined}>FA</a>
        <a href={`${baseUrl}/en/`} aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
      </div>
    </div>
  </div>
</div>

<script>
  const mobileDrawer = document.getElementById('mobile-drawer') as HTMLDivElement | null;
  const menuToggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const focusableSelector = 'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';

  if (mobileDrawer && menuToggle) {
    let previousFocus: HTMLElement | null = null;
    let previousBodyOverflow = '';
    let closeTimer = 0;

    const getFocusable = (): HTMLElement[] => Array.from(
      mobileDrawer.querySelectorAll<HTMLElement>(focusableSelector),
    ).filter((element) => !element.hasAttribute('hidden') && element.getClientRects().length > 0);

    const openDrawer = (): void => {
      window.clearTimeout(closeTimer);
      previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : menuToggle;
      previousBodyOverflow = document.body.style.overflow;
      mobileDrawer.hidden = false;
      menuToggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        mobileDrawer.classList.add('is-open');
        getFocusable()[0]?.focus();
      });
    };

    const closeDrawer = (): void => {
      if (mobileDrawer.hidden) return;
      mobileDrawer.classList.remove('is-open');
      menuToggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = previousBodyOverflow;
      closeTimer = window.setTimeout(() => {
        mobileDrawer.hidden = true;
        previousFocus?.focus();
        previousFocus = null;
      }, 350);
    };

    menuToggle.addEventListener('click', () => {
      if (mobileDrawer.hidden) openDrawer();
      else closeDrawer();
    });

    mobileDrawer.querySelectorAll<HTMLElement>('[data-close-drawer]').forEach((element) => {
      element.addEventListener('click', closeDrawer);
    });
    mobileDrawer.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((anchor) => {
      anchor.addEventListener('click', closeDrawer);
    });

    document.addEventListener('keydown', (event: KeyboardEvent) => {
      if (mobileDrawer.hidden) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        closeDrawer();
        return;
      }
      if (event.key !== 'Tab') return;

      const focusable = getFocusable();
      if (focusable.length === 0) {
        event.preventDefault();
        return;
      }
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }
</script>
