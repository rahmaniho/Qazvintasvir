---
import NavIcon from './NavIcon.astro';

type NavigationIconName = 'home' | 'about' | 'services' | 'trade' | 'customs' | 'sourcing' | 'factory' | 'vip' | 'school' | 'food' | 'consulting' | 'fleet' | 'brands' | 'clients' | 'articles' | 'contact';
interface Props {
  lang: 'fa' | 'en';
  navLinks: Array<{ href: string; label: string; icon: string; current?: boolean }>;
  serviceLinks: Array<{ href: string; label: string; icon: string; current?: boolean }>;
  baseUrl: string;
}
const { lang, navLinks, serviceLinks, baseUrl } = Astro.props;
const labels = lang === 'fa'
  ? { close: 'بستن منو', services: 'خدمات', viewAll: 'فهرست همه‌ی خدمات', contact: 'درخواست مشاوره' }
  : { close: 'Close menu', services: 'Services', viewAll: 'All services', contact: 'Request consultation' };
const ctaHref = `${baseUrl}/${lang}/contact/`;
---

<div
  class="mobile-drawer"
  id="mobile-drawer"
  hidden
  role="dialog"
  aria-modal="true"
  aria-label={lang === 'fa' ? 'منوی موبایل' : 'Mobile navigation'}
>
  <div class="mobile-drawer__backdrop" data-close-drawer></div>
  <div class="mobile-drawer__panel" role="document">
    <div class="mobile-drawer__head">
      <span class="mobile-drawer__brand">{lang === 'fa' ? 'قزوین تصویر' : 'Qazvin Tasvir'}</span>
      <button type="button" class="mobile-drawer__close" aria-label={labels.close} data-close-drawer>
        <span aria-hidden="true">✕</span>
      </button>
    </div>

    <nav class="mobile-drawer__nav" aria-label={lang === 'fa' ? 'ناوبری موبایل' : 'Mobile navigation'}>
      {navLinks.map((link) => (
        <a href={link.href} class="mobile-drawer__link" aria-current={link.current ? 'page' : undefined}>
          <span class="mobile-drawer__link-label"><NavIcon name={link.icon as NavigationIconName} baseUrl={baseUrl} />{link.label}</span>
          <span class="mobile-drawer__link-arrow" aria-hidden="true">›</span>
        </a>
      ))}
      <details>
        <summary><span class="mobile-drawer__link-label"><NavIcon name="services" baseUrl={baseUrl} />{labels.services}</span></summary>
        <div class="mobile-drawer__sub">
          <a href={`${baseUrl}/${lang}/services/`}><NavIcon name="services" baseUrl={baseUrl} />{labels.viewAll}</a>
          {serviceLinks.map((service) => (
            <a href={service.href} aria-current={service.current ? 'page' : undefined}><NavIcon name={service.icon as NavigationIconName} baseUrl={baseUrl} />{service.label}</a>
          ))}
        </div>
      </details>
    </nav>

    <div class="mobile-drawer__foot">
      <a href={ctaHref} class="btn btn--accent mobile-drawer__cta">{labels.contact}</a>
      <div class="mobile-drawer__social" role="group" aria-label={lang === 'fa' ? 'شبکه‌های اجتماعی' : 'Social networks'}>
        <a
          href="https://www.instagram.com/qazvintasvir.co/"
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-drawer__social-link"
          aria-label={lang === 'fa' ? 'صفحه‌ی اینستاگرام قزوین تصویر (@Qazvintasvir.co)' : 'Qazvin Tasvir on Instagram (@Qazvintasvir.co)'}
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
          <bdi class="bidi-ltr" dir="ltr">@Qazvintasvir.co</bdi>
        </a>
        <a
          href="https://wa.me/989122815189"
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-drawer__social-link mobile-drawer__social-link--whatsapp"
          aria-label={lang === 'fa' ? 'ارتباط با قزوین تصویر در واتساپ' : 'Contact Qazvin Tasvir on WhatsApp'}
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654z"></path>
          </svg>
          <span>{lang === 'fa' ? 'واتساپ' : 'WhatsApp'}</span>
        </a>
      </div>
      <div class="mobile-drawer__languages" aria-label={lang === 'fa' ? 'انتخاب زبان' : 'Choose language'}>
        <a href={`${baseUrl}/fa/`} aria-current={lang === 'fa' ? 'page' : undefined}>FA</a>
        <a href={`${baseUrl}/en/`} aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
      </div>
    </div>
  </div>
</div>

<script>
  const mobileDrawer = document.getElementById('mobile-drawer') as HTMLDivElement | null;
  const menuToggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const focusableSelector = 'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';

  if (mobileDrawer && menuToggle) {
    let previousFocus: HTMLElement | null = null;
    let previousBodyOverflow = '';
    let closeTimer = 0;

    const getFocusable = (): HTMLElement[] => Array.from(
      mobileDrawer.querySelectorAll<HTMLElement>(focusableSelector),
    ).filter((element) => !element.hasAttribute('hidden') && element.getClientRects().length > 0);

    const openDrawer = (): void => {
      window.clearTimeout(closeTimer);
      previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : menuToggle;
      previousBodyOverflow = document.body.style.overflow;
      mobileDrawer.hidden = false;
      menuToggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        mobileDrawer.classList.add('is-open');
        getFocusable()[0]?.focus();
      });
    };

    const closeDrawer = (): void => {
      if (mobileDrawer.hidden) return;
      mobileDrawer.classList.remove('is-open');
      menuToggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = previousBodyOverflow;
      closeTimer = window.setTimeout(() => {
        mobileDrawer.hidden = true;
        previousFocus?.focus();
        previousFocus = null;
      }, 350);
    };

    menuToggle.addEventListener('click', () => {
      if (mobileDrawer.hidden) openDrawer();
      else closeDrawer();
    });

    mobileDrawer.querySelectorAll<HTMLElement>('[data-close-drawer]').forEach((element) => {
      element.addEventListener('click', closeDrawer);
    });
    mobileDrawer.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((anchor) => {
      anchor.addEventListener('click', closeDrawer);
    });

    document.addEventListener('keydown', (event: KeyboardEvent) => {
      if (mobileDrawer.hidden) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        closeDrawer();
        return;
      }
      if (event.key !== 'Tab') return;

      const focusable = getFocusable();
      if (focusable.length === 0) {
        event.preventDefault();
        return;
      }
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }
</script>
