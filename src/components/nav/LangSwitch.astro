---
interface Props {
  lang: 'fa' | 'en';
  currentPath: string;
}
const { lang, currentPath } = Astro.props;

// currentPath like /Qazvintasvir/fa/services/import-export/ or /Qazvintasvir/en/...
// Switch to other lang while preserving path
const otherLang = lang === 'fa' ? 'en' : 'fa';

// Remove base and lang prefix to get suffix
let suffix = currentPath;
// Remove base prefix if present
if (suffix.includes('/fa/')) suffix = suffix.substring(suffix.indexOf('/fa/') + 3);
else if (suffix.includes('/en/')) suffix = suffix.substring(suffix.indexOf('/en/') + 3);
else suffix = '/';

if (!suffix.startsWith('/')) suffix = '/' + suffix;

// For root cases
const base = import.meta.env.BASE_URL; // e.g. /Qazvintasvir/
const baseClean = base.endsWith('/') ? base.slice(0,-1) : base;
const href = `${baseClean}/${otherLang}${suffix === '/' ? '/' : suffix}`;
const ariaLabel = lang === 'fa' ? 'Switch to English' : 'Switch to Persian';
---

<a href={href} class="lang-switch" aria-label={ariaLabel} hreflang={otherLang}>
  <span class:list={["lang-switch__label", lang === 'fa' ? "" : "lang-switch__active"]}>FA</span>
  <span aria-hidden="true">/</span>
  <span class:list={["lang-switch__label", lang === 'en' ? "" : "lang-switch__active"]}>EN</span>
</a>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 12px;
    border: 1px solid var(--line-soft);
    border-radius: var(--r-full);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-muted);
    background: var(--surface-white);
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .lang-switch:hover { border-color: var(--text-muted); color: var(--text-primary); }
  .lang-switch__active { color: var(--text-muted); opacity: 0.6; }
  .lang-switch .lang-switch__label:not(.lang-switch__active) { color: var(--primary-navy); }
</style>
