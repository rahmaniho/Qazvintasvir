---
import NavMenu from './NavMenu.astro';
import MobileDrawer from './MobileDrawer.astro';

interface Props {
  lang: 'fa' | 'en';
  currentPath: string;
}
const { lang, currentPath } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, ''); // empty at the custom-domain root
const homeHref = `${baseUrl}/${lang}/`;
const ctaHref = `${baseUrl}/${lang}/contact/`;
const contactLabel = lang === 'fa' ? 'درخواست مشاوره' : 'Get consultation';
const openLabel = lang === 'fa' ? 'باز کردن منوی موبایل' : 'Open mobile menu';
const brandTitle = lang === 'fa' ? 'قزوین تصویر' : 'Qazvin Tasvir';
const brandSub = lang === 'fa' ? 'بازرگانی • ترابری • غذای سازمانی' : 'Trade • Transport • Catering';

// navLinks for drawer
const navLinksFa = [
  { href: `${baseUrl}/fa/`, label: 'خانه', icon: 'home', current: currentPath === `${baseUrl}/fa/` || currentPath === `${baseUrl}/fa` },
  { href: `${baseUrl}/fa/about/`, label: 'درباره ما', icon: 'about', current: currentPath.includes('/about') },
  { href: `${baseUrl}/fa/fleet/`, label: 'ناوگان', icon: 'fleet', current: currentPath.includes('/fleet') },
  { href: `${baseUrl}/fa/brands/`, label: 'برندها', icon: 'brands', current: currentPath.includes('/brands') },
  { href: `${baseUrl}/fa/clients/`, label: 'مشتریان', icon: 'clients', current: currentPath.includes('/clients') },
  { href: `${baseUrl}/fa/articles/`, label: 'مقاله‌ها و راهنماها', icon: 'articles', current: currentPath.includes('/articles') },
  { href: `${baseUrl}/fa/contact/`, label: 'تماس با ما', icon: 'contact', current: currentPath.includes('/contact') },
];
const navLinksEn = [
  { href: `${baseUrl}/en/`, label: 'Home', icon: 'home', current: currentPath === `${baseUrl}/en/` },
  { href: `${baseUrl}/en/about/`, label: 'About', icon: 'about', current: currentPath.includes('/about') },
  { href: `${baseUrl}/en/fleet/`, label: 'Fleet', icon: 'fleet', current: currentPath.includes('/fleet') },
  { href: `${baseUrl}/en/brands/`, label: 'Brands', icon: 'brands', current: currentPath.includes('/brands') },
  { href: `${baseUrl}/en/clients/`, label: 'Clients', icon: 'clients', current: currentPath.includes('/clients') },
  { href: `${baseUrl}/en/articles/`, label: 'Articles & guides', icon: 'articles', current: currentPath.includes('/articles') },
  { href: `${baseUrl}/en/contact/`, label: 'Contact', icon: 'contact', current: currentPath.includes('/contact') },
];
const navLinks = lang === 'fa' ? navLinksFa : navLinksEn;

const serviceLinksFa = [
  { slug: 'import-export', icon: 'trade', label: 'واردات و صادرات کالاهای مجاز', href: `${baseUrl}/fa/services/import-export/` },
  { slug: 'customs-port', icon: 'customs', label: 'ترخیص گمرکی و امور بندری', href: `${baseUrl}/fa/services/customs-port/` },
  { slug: 'sourcing', icon: 'sourcing', label: 'تأمین مواد اولیه و تجهیزات', href: `${baseUrl}/fa/services/sourcing/` },
  { slug: 'factory-transport', icon: 'factory', label: 'ترابری پرسنل کارخانجات', href: `${baseUrl}/fa/services/factory-transport/` },
  { slug: 'urban-vip', icon: 'vip', label: 'حمل‌ونقل درون‌شهری و VIP', href: `${baseUrl}/fa/services/urban-vip/` },
  { slug: 'school-office', icon: 'school', label: 'سرویس مدارس، ادارات و شرکت‌ها', href: `${baseUrl}/fa/services/school-office/` },
  { slug: 'personnel-food', icon: 'food', label: 'تأمین غذای پرسنل', href: `${baseUrl}/fa/services/personnel-food/` },
  { slug: 'trade-consulting', icon: 'consulting', label: 'مشاوره بازرگانی و گشایش', href: `${baseUrl}/fa/services/trade-consulting/` },
].map(s => ({ ...s, current: currentPath.includes(s.slug) }));

const serviceLinksEn = [
  { slug: 'import-export', icon: 'trade', label: 'Import & Export', href: `${baseUrl}/en/services/import-export/` },
  { slug: 'customs-port', icon: 'customs', label: 'Customs & Port Affairs', href: `${baseUrl}/en/services/customs-port/` },
  { slug: 'sourcing', icon: 'sourcing', label: 'Industrial Sourcing', href: `${baseUrl}/en/services/sourcing/` },
  { slug: 'factory-transport', icon: 'factory', label: 'Factory Transport', href: `${baseUrl}/en/services/factory-transport/` },
  { slug: 'urban-vip', icon: 'vip', label: 'Urban & VIP', href: `${baseUrl}/en/services/urban-vip/` },
  { slug: 'school-office', icon: 'school', label: 'School & Office Shuttles', href: `${baseUrl}/en/services/school-office/` },
  { slug: 'personnel-food', icon: 'food', label: 'Staff Catering', href: `${baseUrl}/en/services/personnel-food/` },
  { slug: 'trade-consulting', icon: 'consulting', label: 'Trade Consulting', href: `${baseUrl}/en/services/trade-consulting/` },
].map(s => ({ ...s, current: currentPath.includes(s.slug) }));

const serviceLinks = lang === 'fa' ? serviceLinksFa : serviceLinksEn;

const otherLang = lang === 'fa' ? 'en' : 'fa';
// compute switch href
let suffix = currentPath;
if (suffix.includes('/fa/')) suffix = suffix.substring(suffix.indexOf('/fa/') + 3);
else if (suffix.includes('/en/')) suffix = suffix.substring(suffix.indexOf('/en/') + 3);
else suffix = '/';
if (!suffix.startsWith('/')) suffix = '/' + suffix;
const switchHref = `${baseUrl}/${otherLang}${suffix === '/' ? '/' : suffix}`;
---

<header class="site-header" role="banner">
  <div class="container header-inner">
    <a class="brand" href={homeHref} aria-label={brandTitle}>
      <span class="brand-mark">
        <img src={`${baseUrl}/assets/images/brand/qazvin-tasvir-mark.png`} alt="" width="44" height="44" loading="eager" decoding="async" />
      </span>
      <span class="brand-copy">
        <strong>{brandTitle}</strong>
        <small>{brandSub}</small>
      </span>
    </a>

    <NavMenu lang={lang} currentPath={currentPath} baseUrl={baseUrl} />

    <div class="header-actions">
      <a href={switchHref} class="lang-switch" aria-label={lang === 'fa' ? 'Switch to English' : 'Switch to Persian'} hreflang={otherLang}>
        <span class:list={{ 'is-current': lang === 'fa' }}>FA</span>
        <span aria-hidden="true">/</span>
        <span class:list={{ 'is-current': lang === 'en' }}>EN</span>
      </a>

      <details class="theme-switch">
        <summary class="theme-switch__btn" aria-label={lang === 'fa' ? 'تغییر تم سایت' : 'Change site theme'}>
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="13.5" cy="6.5" r="1.5"></circle><circle cx="17.5" cy="10.5" r="1.5"></circle><circle cx="8.5" cy="7.5" r="1.5"></circle><circle cx="6.5" cy="12.5" r="1.5"></circle>
            <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"></path>
          </svg>
        </summary>
        <div class="theme-switch__panel" role="group" aria-label={lang === 'fa' ? 'انتخاب تم رنگی سایت' : 'Choose a site color theme'}>
          <button type="button" class="theme-option" data-theme-value="light" aria-pressed="true">
            <span class="theme-option__swatch theme-option__swatch--light" aria-hidden="true"></span>
            <span>{lang === 'fa' ? 'روشن' : 'Light'}</span>
            <span class="theme-option__check" aria-hidden="true">✓</span>
          </button>
          <button type="button" class="theme-option" data-theme-value="dark" aria-pressed="false">
            <span class="theme-option__swatch theme-option__swatch--dark" aria-hidden="true"></span>
            <span>{lang === 'fa' ? 'تیره' : 'Dark'}</span>
            <span class="theme-option__check" aria-hidden="true">✓</span>
          </button>
          <button type="button" class="theme-option" data-theme-value="ocean" aria-pressed="false">
            <span class="theme-option__swatch theme-option__swatch--ocean" aria-hidden="true"></span>
            <span>{lang === 'fa' ? 'اقیانوسی' : 'Ocean'}</span>
            <span class="theme-option__check" aria-hidden="true">✓</span>
          </button>
        </div>
      </details>

      <a href={ctaHref} class="btn btn--accent header-actions__cta">
        <span>{contactLabel}</span>
      </a>

      <button id="menu-toggle" class="menu-toggle" type="button" aria-label={openLabel} aria-expanded="false" aria-controls="mobile-drawer">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<MobileDrawer lang={lang} navLinks={navLinks} serviceLinks={serviceLinks} baseUrl={baseUrl} />

<script>
  const header = document.querySelector('.site-header');
  const progress = document.getElementById('scroll-progress');
  const upd = () => {
    const y = window.scrollY || window.pageYOffset;
    if (header) header.classList.toggle('scrolled', y > 12);
    if (progress) {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      progress.style.transform = `scaleX(${max > 0 ? y / max : 0})`;
    }
  };
  window.addEventListener('scroll', upd, { passive: true });
  upd();
  // smooth scroll for internal anchors with header offset
  document.querySelectorAll('a[href*="#"]').forEach(a => {
    a.addEventListener('click', (e) => {
      const href = a.getAttribute('href') || '';
      if (href.includes('#') && href.startsWith('#') || href.includes('/#')) {
        const hash = href.split('#')[1];
        if (!hash) return;
        const target = document.getElementById(hash);
        if (target) {
          e.preventDefault();
          const top = target.getBoundingClientRect().top + window.pageYOffset - 80;
          window.scrollTo({ top, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
          history.pushState(null,'', '#' + hash);
        }
      }
    });
  });
</script>
