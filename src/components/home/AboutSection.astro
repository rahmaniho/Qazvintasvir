---
interface Props { lang: 'fa' | 'en'; }
const { lang } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const isFa = lang === 'fa';
---

<section class="section" id="about">
  <div class="container">
    <div class="about-grid">
      <div class="reveal">
        <span class="section-label">{isFa ? 'درباره ما' : 'About us'}</span>
        <h2 class="section-title">{isFa ? <>بیش از <bdi class="bidi-ltr" dir="ltr">۳۱</bdi> سال اعتماد، از قزوین تا بازارهای جهانی</> : <><bdi class="bidi-ltr" dir="ltr">31+</bdi> years of trust, from Qazvin to global markets</>}</h2>
        <p class="section-desc">
          {isFa
            ? <>قزوین تصویر از سال <bdi class="bidi-ltr" dir="ltr">۱۳۷۴</bdi> در کنار صنایع استان قزوین بوده است. از شهرک‌های صنعتی کاسپین و البرز تا بنادر جنوبی، زنجیرهٔ تأمین و جابه‌جایی شما را با نظم و شفافیت همراهی می‌کنیم.</>
            : <>Since 1995, Qazvin Tasvir has supported industries across Qazvin Province. From the Caspian and Alborz industrial parks to southern ports, we help keep supply and transportation operations organized and transparent.</>}
        </p>
        <ul style="margin-top:20px; display:grid; gap:10px;">
          <li style="display:flex; gap:10px; align-items:center; font-weight:600;"><span style="color:var(--success);">✓</span><span>{isFa ? <>شناسه ملی <bdi class="bidi-ltr" dir="ltr">۱۰۸۶۱۴۱۵۲۱۵</bdi> — ثبت رسمی</> : <>National ID <bdi class="bidi-ltr" dir="ltr">10861415215</bdi> — officially registered</>}</span></li>
          <li style="display:flex; gap:10px; align-items:center; font-weight:600;"><span style="color:var(--success);">✓</span><span>{isFa ? 'مدیریت سعید امین‌زاده — عضو هیئت مدیره' : 'Led by Saeed Aminzadeh — Board member'}</span></li>
          <li style="display:flex; gap:10px; align-items:center; font-weight:600;"><span style="color:var(--success);">✓</span><span>{isFa ? 'پوشش کامل قزوین و شهرک‌های صنعتی' : 'Full coverage of Qazvin industrial zones'}</span></li>
        </ul>
        <div style="margin-top:24px;">
          <a href={`${baseUrl}/${lang}/about/`} class="btn btn--primary">{isFa ? 'بیشتر درباره ما' : 'More about us'} →</a>
        </div>
      </div>
      <div class="reveal">
        <img src={`${baseUrl}/assets/img/sections/about-office.webp`} alt={isFa ? 'دفتر قزوین تصویر' : 'Qazvin Tasvir office'} width="560" height="380" loading="lazy" decoding="async" style="border-radius: var(--r-lg); width:100%; object-fit:cover; aspect-ratio:4/3;" />
      </div>
    </div>
  </div>
</section>
