---
interface Props {
  lang: 'fa' | 'en';
}
const { lang } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const isFa = lang === 'fa';
---

<section class="hero" id="hero">
  <div class="container">
    <div class="hero__grid">
      <div class="reveal">
        <span style="display:inline-flex; align-items:center; gap:8px; background:rgba(255,255,255,0.12); border:1px solid rgba(255,255,255,0.18); padding:6px 14px; border-radius:9999px; font-size:0.78rem; font-weight:700; color:#fff;">
          {isFa ? 'تأسیس ۱۳۷۴ — بیش از ۳۱ سال تجربه' : 'Est. 1995 — 31+ years of experience'}
        </span>
        <h1 style="margin-top:20px;">
          {isFa ? (
            <>قزوین تصویر؛ بیش از ۳۱ سال تجربه در <span class="gradient-text">بازرگانی، واردات و صادرات</span> و ترابری</>
          ) : (
            <>Qazvin Tasvir — 31+ years of excellence in <span class="gradient-text">trading, import & export</span> and transport</>
          )}
        </h1>
        <p class="hero__lead">
          {isFa
            ? 'شرکت قزوین تصویر (شناسه ملی ۱۰۸۶۱۴۱۵۲۱۵) با مدیریت سعید امین‌زاده، هشت مسیر خدمت تخصصی را از بازرگانی بین‌المللی تا حمل‌ونقل و کیترینگ سازمانی در اختیار صنایع قزوین می‌گذارد.'
            : 'Qazvin Tasvir Company (ID 10861415215), led by Saeed Aminzadeh, provides eight specialist service paths from international trade to transport and corporate catering for industries in Qazvin.'}
        </p>
        <div class="hero__actions">
          <a href={`${baseUrl}/${lang}/contact/`} class="btn btn--accent btn--lg">{isFa ? 'درخواست مشاوره رایگان' : 'Free consultation'} →</a>
          <a href={`${baseUrl}/${lang}/services/`} class="btn btn--ghost" style="background:rgba(255,255,255,0.1); color:#fff; border-color:rgba(255,255,255,0.2);">{isFa ? 'مشاهده خدمات' : 'View services'}</a>
        </div>

        <!-- Stats inline -->
        <div style="display:grid; grid-template-columns: repeat(3,1fr); gap:16px; margin-top:40px; border-top:1px solid rgba(255,255,255,0.12); padding-top:20px;">
          <div><strong style="display:block; font-size:1.6rem; color:#fff;">{isFa ? '۳۱+' : '31+'}</strong><span style="font-size:0.84rem; color:#CBD5E1;">{isFa ? 'سال تجربه' : 'Years experience'}</span></div>
          <div><strong style="display:block; font-size:1.6rem; color:#fff;">۸</strong><span style="font-size:0.84rem; color:#CBD5E1;">{isFa ? 'خدمت تخصصی' : 'Services'}</span></div>
          <div><strong style="display:block; font-size:1.6rem; color:#fff;">۲۴/۷</strong><span style="font-size:0.84rem; color:#CBD5E1;">{isFa ? 'پشتیبانی' : 'Support'}</span></div>
        </div>
      </div>

      <div class="reveal" style="position:relative;">
        <img class="hero__img" src={`${baseUrl}/assets/img/sections/hero-port.webp`} alt={isFa ? 'بندر کانتینری قزوین تصویر' : 'Qazvin Tasvir port'} width="560" height="420" loading="eager" fetchpriority="high" decoding="async" />
        <div style="position:absolute; bottom:16px; inset-inline:16px; background:rgba(255,255,255,0.96); backdrop-filter:blur(8px); border-radius:12px; padding:12px 16px; display:flex; align-items:center; gap:12px; box-shadow:var(--shadow-md);">
          <img src={`${baseUrl}/assets/images/saeed-aminzadeh-avatar.webp`} alt="" width="40" height="40" style="border-radius:50%; width:40px; height:40px; object-fit:cover;" loading="lazy" decoding="async" />
          <div>
            <strong style="display:block; font-size:0.9rem; color:var(--navy-deep);">{isFa ? 'سعید امین‌زاده' : 'Saeed Aminzadeh'}</strong>
            <span style="font-size:0.78rem; color:var(--text-muted);">{isFa ? 'مدیرعامل و بنیان‌گذار' : 'CEO & Founder'}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
