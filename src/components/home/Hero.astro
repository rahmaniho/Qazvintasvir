---
interface Props {
  lang: 'fa' | 'en';
}
const { lang } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const isFa = lang === 'fa';
---

<section class="hero" id="hero">
  <div class="container">
    <div class="hero__grid">
      <div class="reveal">
        <span style="display:inline-flex; align-items:center; gap:8px; background:rgba(255,255,255,0.12); border:1px solid rgba(255,255,255,0.18); padding:6px 14px; border-radius:9999px; font-size:0.78rem; font-weight:700; color:#fff;">
          {isFa ? <>تأسیس <bdi class="bidi-ltr" dir="ltr">۱۳۷۴</bdi> — بیش از <bdi class="bidi-ltr" dir="ltr">۳۱</bdi> سال تجربه</> : <>Est. <bdi class="bidi-ltr" dir="ltr">1995</bdi> — <bdi class="bidi-ltr" dir="ltr">31+</bdi> years of experience</>}
        </span>
        <h1 style="margin-top:20px;">
          {isFa ? (
            <>قزوین تصویر؛ بیش از <bdi class="bidi-ltr" dir="ltr">۳۱</bdi> سال تجربه در <span class="gradient-text">بازرگانی، واردات و صادرات</span> و حمل‌ونقل</>
          ) : (
            <>Qazvin Tasvir — <bdi class="bidi-ltr" dir="ltr">31+</bdi> years of experience in <span class="gradient-text">trade, import and export</span>, and transportation</>
          )}
        </h1>
        <p class="hero__lead">
          {isFa
            ? <>شرکت قزوین تصویر (شناسه ملی <bdi class="bidi-ltr" dir="ltr">۱۰۸۶۱۴۱۵۲۱۵</bdi>) با مدیریت سعید امین‌زاده، هشت حوزه‌ی تخصصی خدمات را از بازرگانی بین‌المللی تا حمل‌ونقل و تأمین غذای سازمانی برای صنایع استان قزوین فراهم می‌کند.</>
            : <>Qazvin Tasvir Company (National ID <bdi class="bidi-ltr" dir="ltr">10861415215</bdi>), led by Saeed Aminzadeh, provides eight specialist services—from international trade to transportation and corporate catering—for organizations in Qazvin Province.</>}
        </p>
        <div class="hero__actions">
          <a href={`${baseUrl}/${lang}/contact/`} class="btn btn--accent btn--lg">{isFa ? 'درخواست مشاوره رایگان' : 'Free consultation'} →</a>
          <a href={`${baseUrl}/${lang}/services/`} class="btn btn--ghost" style="background:rgba(255,255,255,0.1); color:#fff; border-color:rgba(255,255,255,0.2);">{isFa ? 'مشاهده خدمات' : 'View services'}</a>
        </div>

        <!-- Stats inline -->
        <div class="hero__facts-grid">
          <div><strong style="display:block; font-size:1.6rem; color:#fff;">{isFa ? <bdi class="bidi-ltr" dir="ltr">۳۱+</bdi> : <bdi class="bidi-ltr" dir="ltr">31+</bdi>}</strong><span style="font-size:0.84rem; color:#CBD5E1;">{isFa ? 'سال تجربه' : 'Years of experience'}</span></div>
          <div><strong style="display:block; font-size:1.6rem; color:#fff;">{isFa ? <bdi class="bidi-ltr" dir="ltr">۸</bdi> : <bdi class="bidi-ltr" dir="ltr">8</bdi>}</strong><span style="font-size:0.84rem; color:#CBD5E1;">{isFa ? 'خدمت تخصصی' : 'Services'}</span></div>
          <div><strong style="display:block; font-size:1.6rem; color:#fff;">{isFa ? <bdi class="bidi-ltr" dir="ltr">۲۴/۷</bdi> : <bdi class="bidi-ltr" dir="ltr">24/7</bdi>}</strong><span style="font-size:0.84rem; color:#CBD5E1;">{isFa ? 'پشتیبانی' : 'Support'}</span></div>
        </div>
      </div>

      <div class="hero__visual reveal">
        <img class="hero__img" src={`${baseUrl}/assets/img/sections/hero-port.webp`} alt={isFa ? 'نمایی از بندر کانتینری برای نمایش خدمات بازرگانی' : 'Container port representing the company’s trade services'} width="560" height="420" loading="eager" fetchpriority="high" decoding="async" />
        <div class="hero-profile-card">
          <img src={`${baseUrl}/assets/images/saeed-aminzadeh-avatar.webp`} alt="" width="40" height="40" loading="lazy" decoding="async" />
          <div>
            <strong>{isFa ? 'سعید امین‌زاده' : 'Saeed Aminzadeh'}</strong>
            <span>{isFa ? 'مدیرعامل و بنیان‌گذار' : 'CEO & Founder'}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
