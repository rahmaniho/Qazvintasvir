---
interface Props { lang: 'fa' | 'en'; }
const { lang } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const isFa = lang === 'fa';
const clients = [
  { name: 'LG', img: '/assets/images/clients/lg.png' },
  { name: 'Nestle', img: '/assets/images/clients/nestle.png' },
  { name: 'Unilever', img: '/assets/images/clients/unilever.png' },
  { name: 'Henkel', img: '/assets/images/clients/henkel.png' },
  { name: 'Goldiran', img: '/assets/images/clients/goldiran.png' },
  { name: 'AGT', img: '/assets/images/clients/agt.png' },
  { name: 'Alborz Cable', img: '/assets/images/clients/alborz-cable.png' },
  { name: 'BAT', img: '/assets/images/clients/bat.png' },
];
---

<section class="section" id="clients">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label section-label--sky">{isFa ? 'مشتریان' : 'Clients'}</span>
      <h2 class="section-title">{isFa ? 'برندهای شاخصی که به قزوین تصویر اعتماد کرده‌اند' : 'Leading brands that trust Qazvin Tasvir'}</h2>
    </div>

    <div class="clients-grid">
      {clients.map(c => (
        <div class="client-card reveal">
          <img src={`${baseUrl}${c.img}`} alt={c.name} width="120" height="48" loading="lazy" decoding="async" />
        </div>
      ))}
    </div>

    <div class="brands-strip reveal" style="margin-top:40px;">
      <img src={`${baseUrl}/assets/logos/scania.svg`} alt="Scania" width="80" height="32" loading="lazy" decoding="async" />
      <img src={`${baseUrl}/assets/logos/volvo.svg`} alt="Volvo" width="80" height="32" loading="lazy" decoding="async" />
      <img src={`${baseUrl}/assets/logos/mercedes.svg`} alt="Mercedes" width="80" height="32" loading="lazy" decoding="async" />
      <img src={`${baseUrl}/assets/logos/iveco.svg`} alt="Iveco" width="80" height="32" loading="lazy" decoding="async" />
    </div>
  </div>
</section>
