---
interface Props { lang: 'fa' | 'en'; }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fa = lang === 'fa';
const reasons = fa
  ? [
      ['۳۱+ سال سابقه صنعتی (تأسیس ۱۳۷۴)', 'تداوم فعالیت از سال ۱۳۷۴ نشان‌دهنده‌ی تعهد بلندمدت و ثبات اجرایی در شرایط متغیر اقتصادی است.'],
      ['مدیریت سعید امین‌زاده', 'مدیرعامل بر قراردادها نظارت مستقیم دارد و پاسخ‌گوی مشتریان سازمانی و بازرگانان است.'],
      ['ناوگان ملکی و مجهز', 'اتوبوس، مینی‌بوس و ون‌های مجهز، همراه با خودروهای پشتیبان در صورت نیاز.'],
      ['شبکه‌ی تأمین داخلی و خارجی', 'ارتباط با بازارهای مبدأ و زنجیره‌ی تأمین مواد اولیه و تجهیزات تولیدی، با امکان تأمین مستقیم.'],
      ['پشتیبانی ۲۴/۷ و قراردادهای منعطف', 'شرایط پرداخت و قراردادهای ماهانه یا سالانه منعطف است و تیم ما برای تغییرات شیفتی پاسخ‌گو می‌ماند.'],
      ['رضایت بالا و تمدید مداوم قراردادها', 'بیش از ۹۰٪ کارخانه‌های طرف قرارداد، همکاری خود را برای بیش از ۵ سال متوالی با قزوین تصویر تمدید کرده‌اند.'],

    ]
  : [
      ['31+ years of industrial experience (founded 1995)', 'Our continuity since 1995 reflects a long-term commitment to dependable operations through changing economic conditions.'],
      ['Leadership by Saeed Aminzadeh', 'The CEO directly oversees contracts and is accountable for relationships with corporate clients and traders.'],
      ['Company-owned, well-equipped fleet', 'We provide buses, minibuses and vans, with backup vehicles available when required.'],
      ['Domestic and international supply network', 'Established relationships with source markets support direct supply channels for raw materials and production equipment.'],
      ['24/7 support and flexible contracts', 'We offer flexible payment terms and monthly or annual contracts, with ongoing support when shifts change.'],
      ['High satisfaction and contract renewals', 'More than 90% of contracted factories have renewed their cooperation with Qazvin Tasvir for over five consecutive years.'],
    ];
const quote = fa
  ? '«تعهد ما، آرامش خاطر شماست. در قزوین تصویر، هر محموله را سرمایه‌ی شما و هر مسافر را امانتی ارزشمند می‌دانیم.»'
  : 'Our commitment is your peace of mind. At Qazvin Tasvir, we treat every shipment as a valuable asset and every passenger as someone entrusted to our care.';
const renderLocalizedText = (text: string, isolateFa = false) => {
  const escaped = text.replace(/[&<>]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[char]!);
  return isolateFa
    ? escaped.replace(/[۰-۹]+(?:[٬,./][۰-۹]+)*(?:[٪%+])?/g, '<bdi class="bidi-ltr" dir="ltr">$&</bdi>')
    : escaped;
};
---

<section class="section section--alt why-us" id="why-us" aria-labelledby="why-us-title">
  <div class="why-us__banner" aria-hidden="true">
    <picture>
      <source srcset={`${base}/assets/img/sections/why-banner.webp`} type="image/webp" />
      <img src={`${base}/assets/img/sections/why-banner.jpg`} alt="" width="1600" height="718" loading="lazy" decoding="async" />
    </picture>
  </div>
  <div class="container">
    <header class="section-header reveal">
      <span class="section-label">{fa ? 'تمایز و مزیت‌های رقابتی' : 'Distinction and competitive advantages'}</span>
      <h2 class="section-title" id="why-us-title">{fa ? 'چرا شرکت‌ها قزوین تصویر را انتخاب می‌کنند؟' : 'Why do companies choose Qazvin Tasvir?'}</h2>
      <p class="section-desc">
        {fa
          ? <>ترکیب بیش از <bdi class="bidi-ltr" dir="ltr">۳۱</bdi> سال سابقه‌ی عملیاتی با استانداردهای نوین مدیریت لجستیک و بازرگانی</>
          : <>More than <bdi class="bidi-ltr" dir="ltr">31</bdi> years of operating experience, combined with modern standards of logistics and trade management</>}
      </p>
    </header>
    <div class="why-us__grid">
      {reasons.map(([title, description]) => (
        <article class="why-card reveal">
          <h3 set:html={renderLocalizedText(title, fa)}></h3>
          <p set:html={renderLocalizedText(description, fa)}></p>
        </article>
      ))}
    </div>
    <blockquote class="why-us__quote reveal">
      <p>{quote}</p>
      <footer>
        <img src={`${base}/assets/images/saeed-aminzadeh-avatar.webp`} alt="" width="60" height="72" loading="lazy" decoding="async" />
        <span>{fa ? '— سعید امین‌زاده | مدیرعامل شرکت قزوین تصویر' : '— Saeed Aminzadeh | CEO of Qazvin Tasvir Company'}</span>
      </footer>
    </blockquote>
  </div>
</section>
