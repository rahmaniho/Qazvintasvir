---
interface Props { lang: 'fa' | 'en'; }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fa = lang === 'fa';
const brands = [
  { key: 'scania', asset: 'scania.svg', fa: 'اسکانیا', en: 'Scania' },
  { key: 'volvo', asset: 'volvo.svg', fa: 'ولوو', en: 'Volvo' },
  { key: 'mercedes', asset: 'mercedes.svg', fa: 'مرسدس‌بنز', en: 'Mercedes-Benz' },
  { key: 'iveco', asset: 'iveco.svg', fa: 'ایویکو', en: 'IVECO' },
  { key: 'irankhodro', asset: 'iran-khodro-diesel.png', fa: 'ایران‌خودرو دیزل', en: 'Iran Khodro Diesel' },
  { key: 'toyota', asset: 'toyota.svg', fa: 'تویوتا', en: 'Toyota' },
  { key: 'hyundai', asset: 'hyundai.svg', fa: 'هیوندای', en: 'Hyundai' },
];
---

<section class="section brand-partners" id="brands" aria-labelledby="brands-title">
  <div class="container">
    <header class="section-header reveal">
      <span class="section-label section-label--onDark">{fa ? 'نشان‌های ناوگان' : 'Fleet marks'}</span>
      <h2 class="section-title" id="brands-title">{fa ? 'برندهای خودروهای ناوگان' : 'Vehicle brands in our fleet'}</h2>
      <p class="section-desc">
        {fa
          ? 'در این بخش، نشان‌های گرافیکی سازندگان خودروهای به‌کاررفته در ناوگان قزوین تصویر را می‌بینید.'
          : 'Explore the original graphic marks of vehicle manufacturers represented in the Qazvin Tasvir fleet.'}
      </p>
    </header>
    <ul class="brand-partners__grid" aria-label={fa ? 'نشان برندهای خودرو' : 'Vehicle brand logos'}>
      {brands.map((brand) => (
        <li class={`brand-partners__item brand-partners__item--${brand.key} reveal`}>
          <span class="brand-partners__logo-frame" aria-hidden="true">
            <img
              class="brand-partners__logo"
              src={`${base}/assets/logos/${brand.asset}`}
              alt=""
              width="160"
              height="96"
              loading="lazy"
              decoding="async"
            />
          </span>
          <span class="brand-partners__name">
            {fa
              ? <>{brand.fa} <bdi dir="ltr">({brand.en})</bdi></>
              : brand.en}
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
