---
interface Props { lang: 'fa' | 'en'; }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fa = lang === 'fa';
const brands = [
  { key: 'scania', asset: 'scania.png', width: 332, height: 206, fa: 'اسکانیا', en: 'Scania' },
  { key: 'volvo', asset: 'volvo.png', width: 328, height: 318, fa: 'ولوو', en: 'Volvo' },
  { key: 'mercedes', asset: 'mercedes.png', width: 969, height: 684, fa: 'مرسدس‌بنز', en: 'Mercedes-Benz' },
  { key: 'iveco', asset: 'iveco.png', width: 585, height: 666, fa: 'ایویکو', en: 'IVECO' },
  { key: 'irankhodro', asset: 'iran-khodro-diesel.png', width: 372, height: 186, fa: 'ایران‌خودرو دیزل', en: 'Iran Khodro Diesel' },
  { key: 'toyota', asset: 'toyota.png', width: 221, height: 185, fa: 'تویوتا', en: 'Toyota' },
  { key: 'hyundai', asset: 'hyundai.png', width: 287, height: 187, fa: 'هیوندای', en: 'Hyundai' },
];
---

<section class="section brand-partners" id="brands" aria-labelledby="brands-title">
  <div class="container">
    <header class="section-header reveal">
      <span class="section-label section-label--onDark">{fa ? 'ناوگان حمل‌ونقل' : 'Transport fleet'}</span>
      <h2 class="section-title" id="brands-title">{fa ? 'برندهای به‌کاررفته در ناوگان' : 'Vehicle brands in our fleet'}</h2>
    </header>
    <ul class="brand-partners__grid" aria-label={fa ? 'نشان برندهای خودرو' : 'Vehicle brand logos'}>
      {brands.map((brand) => (
        <li class={`brand-partners__item brand-partners__item--${brand.key} reveal`}>
          <span class="brand-partners__logo-frame" aria-hidden="true">
            <img
              class="brand-partners__logo"
              src={`${base}/assets/logos/${brand.asset}`}
              alt=""
              width={brand.width}
              height={brand.height}
              loading="eager"
              decoding="async"
            />
          </span>
          <span class="brand-partners__name">{fa ? brand.fa : brand.en}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
