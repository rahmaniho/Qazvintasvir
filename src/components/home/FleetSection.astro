---
interface Props { lang: 'fa' | 'en'; }
const { lang } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const isFa = lang === 'fa';
---

<section class="section" id="fleet">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label section-label--sky">{isFa ? 'ناوگان' : 'Fleet'}</span>
      <h2 class="section-title">{isFa ? 'ناوگان مجهز ترابری' : 'Modern Transport Fleet'}</h2>
      <p class="section-desc">{isFa ? 'اتوبوس، مینی‌بوس و ون‌های مجهز برای جابه‌جایی ایمن و منظم پرسنل در تمام شیفت‌ها.' : 'Buses, minibuses and vans for safe, regular personnel transport across all shifts.'}</p>
    </div>

    <div class="fleet-grid">
      <div class="fleet-card reveal">
        <div class="fleet-card__media"><img src={`${baseUrl}/assets/images/bus-fleet.webp`} alt={isFa ? 'اتوبوس سرویس پرسنل' : 'Staff bus'} width="400" height="280" loading="lazy" decoding="async" /></div>
        <div class="fleet-card__body">
          <h3>{isFa ? 'اتوبوس' : 'Bus'}</h3>
          <p>{isFa ? <>ظرفیت <bdi class="bidi-ltr" dir="ltr">۴۴</bdi> نفره — مناسب سرویس‌های پرجمعیت کارخانه و شهرک‌های صنعتی</> : <><bdi class="bidi-ltr" dir="ltr">44</bdi> seats — for large factory and industrial park shuttles</>}</p>
        </div>
      </div>
      <div class="fleet-card reveal">
        <div class="fleet-card__media"><img src={`${baseUrl}/assets/images/hyundai-minibus-exterior.jpg`} alt={isFa ? 'نمای بیرونی مینی‌بوس هیوندای' : 'Exterior of a Hyundai minibus'} width="400" height="280" loading="lazy" decoding="async" /></div>
        <div class="fleet-card__body">
          <h3>{isFa ? 'مینی‌بوس هیوندای' : 'Hyundai Minibus'}</h3>
          <p>{isFa ? <>ظرفیت <bdi class="bidi-ltr" dir="ltr">۱۸</bdi> نفره — چابک برای مسیرهای شهری و بین‌شهری</> : <><bdi class="bidi-ltr" dir="ltr">18</bdi> seats — agile for urban and intercity routes</>}</p>
        </div>
      </div>
      <div class="fleet-card reveal">
        <div class="fleet-card__media"><img src={`${baseUrl}/assets/images/van-fleet.webp`} alt={isFa ? 'ون' : 'Van'} width="400" height="280" loading="lazy" decoding="async" /></div>
        <div class="fleet-card__body">
          <h3>{isFa ? 'ون مسافربری' : 'Passenger Van'}</h3>
          <p>{isFa ? <>ظرفیت <bdi class="bidi-ltr" dir="ltr">۱۴</bdi> نفره — مناسب گروه‌های کوچک و سرویس VIP</> : <><bdi class="bidi-ltr" dir="ltr">14</bdi> seats — for small groups and VIP service</>}</p>
        </div>
      </div>
    </div>

    <div class="fleet-equipment-grid reveal">
      <img src={`${baseUrl}/assets/images/hyundai-minibus-interior.jpg`} alt={isFa ? 'فضای داخلی مینی‌بوس هیوندای با نشان قزوین تصویر' : 'Hyundai minibus interior with the Qazvin Tasvir logo'} width="560" height="320" loading="lazy" decoding="async" style="border-radius:var(--r-lg); width:100%; aspect-ratio:16/10; object-fit:cover;" />
      <img src={`${baseUrl}/assets/img/fleet-specs/vip-catering.webp`} alt={isFa ? 'پذیرایی VIP' : 'VIP catering'} width="560" height="320" loading="lazy" decoding="async" style="border-radius:var(--r-lg); width:100%; aspect-ratio:16/10; object-fit:cover;" />
    </div>
  </div>
</section>
