---
interface Props { lang: 'fa' | 'en'; }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fa = lang === 'fa';
const pages = fa
  ? [
      { slug: 'about', icon: 'about', title: 'درباره قزوین تصویر' },
      { slug: 'services', icon: 'services', title: 'خدمات تخصصی' },
      { slug: 'fleet', icon: 'fleet', title: 'ناوگان ترابری' },
      { slug: 'brands', icon: 'brands', title: 'برندهای ناوگان' },
      { slug: 'why-us', icon: 'consulting', title: 'چرا قزوین تصویر؟' },
      { slug: 'clients', icon: 'clients', title: 'مشتریان و سوابق' },
      { slug: 'trust', icon: 'customs', title: 'اعتبار و شفافیت' },
      { slug: 'resume', icon: 'sourcing', title: 'رزومه شرکت' },
      { slug: 'legal', icon: 'customs', title: 'شناسنامه حقوقی' },
      { slug: 'contact', icon: 'contact', title: 'تماس و درخواست همکاری' },
    ]
  : [
      { slug: 'about', icon: 'about', title: 'About Qazvin Tasvir' },
      { slug: 'services', icon: 'services', title: 'Specialist Services' },
      { slug: 'fleet', icon: 'fleet', title: 'Transport Fleet' },
      { slug: 'brands', icon: 'brands', title: 'Fleet Brands' },
      { slug: 'why-us', icon: 'consulting', title: 'Why Qazvin Tasvir?' },
      { slug: 'clients', icon: 'clients', title: 'Clients & Track Record' },
      { slug: 'trust', icon: 'customs', title: 'Credentials & Transparency' },
      { slug: 'resume', icon: 'sourcing', title: 'Company Resume' },
      { slug: 'legal', icon: 'customs', title: 'Legal Identity' },
      { slug: 'contact', icon: 'contact', title: 'Contact & Partnership' },
    ];
---

<section class="section home-directory" aria-labelledby="home-directory-title">
  <div class="container">
    <div class="home-directory__panel">
      <header class="home-directory__header">
        <h2 class="home-directory__title" id="home-directory-title">{fa ? 'منوی سریع' : 'Quick Menu'}</h2>
      </header>
      <nav class="home-directory__grid" aria-label={fa ? 'فهرست صفحه‌های سایت' : 'Site pages'}>
        {pages.map((page) => (
          <a class="home-directory__card" href={`${base}/${lang}/${page.slug}/`}>
            <span class="home-directory__icon-wrap" aria-hidden="true">
              {page.icon === 'clients' ? (
                <svg class="home-directory__clients-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                  <circle cx="10" cy="7" r="4" />
                  <path d="M20 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
              ) : (
                <span class="navigation-icon" data-icon={page.icon} style={`--nav-icon-sprite: url('${base}/assets/icons/navigation-sprite.svg')`}></span>
              )}
            </span>
            <span class="home-directory__copy">{page.title}</span>
            <span class="home-directory__arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>
    </div>
  </div>
</section>
