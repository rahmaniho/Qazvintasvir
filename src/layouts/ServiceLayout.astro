---
import BaseLayout from './BaseLayout.astro';
import { organizationSchema, serviceSchema, breadcrumbSchema, faqSchema } from '../lib/schema';

interface Props {
  lang: 'fa' | 'en';
  title: string;
  description: string;
  metaDescription?: string;
  image?: string;
  imageAlt?: string;
  kicker?: string;
  highlight?: string;
  excerpt?: string;
  points?: string[];
  metrics?: [string,string][];
  benefits?: { title: string; text: string }[];
  features?: [string,string,string][];
  processTitle?: string;
  processDesc?: string;
  process?: [string,string,string][];
  detailsTitle?: string;
  detailsBody?: string;
  detailsItems?: string[];
  noteTitle?: string;
  noteBody?: string;
  noteItems?: string[];
  relatedServices?: Array<{ slug: string; tag: string; title: string; summary: string }>;
  ctaTitle?: string;
  ctaBody?: string;
  ctaLabel?: string;
  introTitle?: string;
  intro?: string[];
  asideTitle?: string;
  asideText?: string;
  asideItems?: string[];
  storyKicker?: string;
  storyTitle?: string;
  storyBody?: string;
  storyItems?: string[];
  storyImage?: string;
  storyAlt?: string;
  slug: string;
  canonical?: string;
  faqs?: Array<{q:string, a:string}>;
}

const props = Astro.props;
const lang = props.lang;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site?.toString() || 'https://qazvintasvir.ir';
const siteClean = site.endsWith('/') ? site.slice(0,-1) : site;
const baseClean = baseUrl;

const siteUrl = `${siteClean}${baseClean}`;
const serviceUrl = props.canonical || `${siteUrl}/${lang}/services/${props.slug}/`;
const homeUrl = `${siteUrl}/${lang}/`;
const servicesUrl = `${siteUrl}/${lang}/services/`;

// schema
const org = organizationSchema(siteUrl, lang);
const svcSchema = serviceSchema({ title: props.title, description: props.description, image: props.image ? `${siteClean}${props.image}` : undefined, url: serviceUrl, providerUrl: siteUrl, lang });
const crumbs = breadcrumbSchema([
  { name: lang==='fa' ? 'خانه' : 'Home', url: homeUrl },
  { name: lang==='fa' ? 'خدمات' : 'Services', url: servicesUrl },
  { name: props.title }
]);
const faqList = props.faqs && props.faqs.length ? faqSchema(props.faqs) : null;

// hreflang
const hreflang = [
  { lang: 'fa', href: `${siteClean}${baseClean}/fa/services/${props.slug}/` },
  { lang: 'en', href: `${siteClean}${baseClean}/en/services/${props.slug}/` },
  { lang: 'x-default', href: `${siteClean}${baseClean}/fa/services/${props.slug}/` }
];
const canonical = serviceUrl;
---

<BaseLayout title={`${props.title} | ${lang==='fa' ? 'قزوین تصویر' : 'Qazvin Tasvir'}`} description={props.metaDescription || props.description} lang={lang} image={`${siteUrl}/assets/images/og-image.jpg`} canonical={canonical} hreflang={hreflang} schema={null}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(org)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(svcSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(crumbs)}></script>
    {faqList && <script type="application/ld+json" set:html={JSON.stringify(faqList)}></script>}
  </Fragment>

  <!-- Service Hero -->
  <section class="service-hero" id={props.slug === 'urban-vip' ? 'fleet-specs' : undefined} aria-labelledby="service-title">
    <div class="container">
      <nav class="breadcrumbs" aria-label={lang==='fa' ? 'مسیر صفحه' : 'Breadcrumb'}>
        <a href={`${baseClean}/${lang}/`}>{lang==='fa' ? 'خانه' : 'Home'}</a>
        <span class="breadcrumbs__sep">/</span>
        <a href={`${baseClean}/${lang}/services/`}>{lang==='fa' ? 'خدمات' : 'Services'}</a>
        <span class="breadcrumbs__sep">/</span>
        <span aria-current="page">{props.title}</span>
      </nav>

      <div class="service-hero__grid">
        <div>
          {props.kicker && <span class="eyebrow">{props.kicker}</span>}
          <h1 id="service-title">
            {props.highlight ? (
              <>
                {props.title.replace(props.highlight, '').trim()} <span class="gradient-text" style="background:var(--grad-amber); -webkit-background-clip:text;">{props.highlight}</span>
              </>
            ) : props.title}
          </h1>
          <p class="hero__lead" style="color:#CBD5E1; margin-top:16px;">{props.excerpt || props.description}</p>

          {props.points && props.points.length > 0 && (
            <ul class="hero-points" aria-label={lang==='fa' ? 'نکات اصلی خدمت' : 'Key points'}>
              {props.points.map(p => <li><span aria-hidden="true">✓</span><span>{p}</span></li>)}
            </ul>
          )}

          <div class="hero__actions" style="margin-top:24px;">
            <a href={`${baseClean}/${lang}/contact/`} class="btn btn--accent">{lang === 'fa' ? 'درخواست بررسی نیاز' : 'Request a consultation'} →</a>
            <a href={`${baseClean}/${lang}/services/`} class="btn" style="background:rgba(255,255,255,0.1); color:#fff; border-color:rgba(255,255,255,0.2);">{lang==='fa' ? 'مشاهده همه خدمات' : 'All services'}</a>
          </div>

          {props.metrics && (
            <div class="hero-metrics">
              {props.metrics.map(([val, label]) => (
                <div class="hero-metric"><strong><bdi class="bidi-ltr" dir="ltr">{val}</bdi></strong><span>{label}</span></div>
              ))}
            </div>
          )}
        </div>

        <div class="reveal" style="border-radius: var(--r-lg); overflow:hidden; background:#0B1A30; border:1px solid rgba(255,255,255,0.1);">
          {props.image ? (
            <img src={`${baseClean}${props.image}`} alt={props.imageAlt || props.title} loading="eager" decoding="async" style="width:100%; aspect-ratio:4/3; object-fit:cover;" />
          ) : (
            <div style="aspect-ratio:4/3; display:grid; place-items:center; color:#64748B;">{props.title}</div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Intro / Why -->
  {(props.introTitle || props.intro || props.asideTitle) && (
    <section class="content-section" aria-labelledby="intro-title">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-label">{lang==='fa' ? 'چرا این خدمت؟' : 'Why this service?'}</span>
          <h2 id="intro-title">{props.introTitle || props.title}</h2>
          <p>{lang === 'fa' ? 'راهکار اجرایی باید با شرایط واقعی مجموعهٔ شما هماهنگ باشد.' : 'A practical solution should reflect your organisation’s needs and operating conditions.'}</p>
        </div>

        <div style="display:grid; grid-template-columns: 0.9fr 1.1fr; gap:32px;" class="intro-layout">
          <aside class="card reveal" style="height:fit-content;">
            {props.asideTitle && <span style="font-weight:700; color:var(--amber-accent); font-size:0.84rem;">{props.asideTitle}</span>}
            {props.asideText && <p style="margin-top:8px;">{props.asideText}</p>}
            {props.asideItems && (
              <ul style="margin-top:16px; display:grid; gap:10px;">
                {props.asideItems.map(it => <li style="display:flex; gap:8px; align-items:center; color:var(--text-primary); font-weight:600; font-size:0.9rem;"><span style="color:var(--success);">✓</span><span>{it}</span></li>)}
              </ul>
            )}
          </aside>
          <div class="reveal">
            {props.intro?.map(p => <p style="margin-bottom:16px;">{p}</p>)}
            {props.features && (
              <div style="display:grid; gap:16px; margin-top:24px;">
                {props.features.map(([num, title, text]) => (
                  <div style="display:flex; gap:16px; align-items:flex-start; background:var(--surface-white); border:1px solid var(--line-soft); border-radius:var(--r-md); padding:16px;">
                    <span style="flex:0 0 36px; height:36px; display:grid; place-items:center; background:var(--grad-amber); color:var(--navy-deep); font-weight:800; border-radius:8px;"><bdi class="bidi-ltr" dir="ltr">{num}</bdi></span>
                    <div>
                      <h3 class="service-feature__title">{title}</h3>
                      <span style="color:var(--text-muted); font-size:0.92rem;">{text}</span>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Process -->
  {props.process && props.process.length > 0 && (
    <section class="content-section content-section--alt" aria-labelledby="process-title">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-label section-label--sky">{lang==='fa' ? 'فرآیند همکاری' : 'Process'}</span>
          <h2 id="process-title">{props.processTitle || (lang==='fa' ? 'فرآیند همکاری' : 'How it works')}</h2>
          {props.processDesc && <p>{props.processDesc}</p>}
        </div>
        <div class="process-steps">
          {props.process.map(([num, title, text]) => (
            <div class="process-step reveal">
              <span class="process-step__num"><bdi class="bidi-ltr" dir="ltr">{num}</bdi></span>
              <h3 style="font-size:1rem;">{title}</h3>
              <p style="font-size:0.9rem;">{text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Service details, source note, story and related services -->
  {(props.detailsTitle || props.noteTitle || props.storyTitle || (props.relatedServices && props.relatedServices.length > 0)) && (
    <section class="content-section service-details" aria-label={lang === 'fa' ? 'جزئیات خدمت' : 'Service details'}>
      <div class="container">
        {(props.detailsTitle || props.noteTitle) && (
          <div class="service-detail-grid">
            {props.detailsTitle && (
              <article class="service-detail-card reveal">
                <h2>{props.detailsTitle}</h2>
                {props.detailsBody && <p>{props.detailsBody}</p>}
                {props.detailsItems && props.detailsItems.length > 0 && (
                  <ul class="service-detail-list">
                    {props.detailsItems.map((item) => <li><span aria-hidden="true">✓</span><span>{item}</span></li>)}
                  </ul>
                )}
              </article>
            )}
            {props.noteTitle && (
              <aside class="service-detail-card service-detail-card--note reveal">
                <h2>{props.noteTitle}</h2>
                {props.noteBody && <p>{props.noteBody}</p>}
                {props.noteItems && props.noteItems.length > 0 && (
                  <ul class="service-detail-list">
                    {props.noteItems.map((item) => <li><span aria-hidden="true">✓</span><span>{item}</span></li>)}
                  </ul>
                )}
              </aside>
            )}
          </div>
        )}

        {props.storyTitle && (
          <div class="service-story reveal">
            {(props.storyImage || props.image) && (
              <div class="service-story__image">
                <img
                  src={`${baseClean}${(props.storyImage || props.image)!}`}
                  alt={props.storyAlt || props.storyTitle || props.title}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
            <div class="service-story__copy">
              {props.storyKicker && <span class="section-label">{props.storyKicker}</span>}
              <h2>{props.storyTitle}</h2>
              {props.storyBody && <p>{props.storyBody}</p>}
              {props.storyItems && props.storyItems.length > 0 && (
                <ul class="service-detail-list">
                  {props.storyItems.map((item) => <li><span aria-hidden="true">✓</span><span>{item}</span></li>)}
                </ul>
              )}
            </div>
          </div>
        )}

        {props.relatedServices && props.relatedServices.length > 0 && (
          <section class="related-services" aria-labelledby="related-services-title">
            <div class="related-services__heading">
              <div>
                <span class="section-label">{lang === 'fa' ? 'راهکارهای دیگر' : 'Explore more'}</span>
                <h2 id="related-services-title">{lang === 'fa' ? 'خدمات مرتبط' : 'Related services'}</h2>
              </div>
              <a href={servicesUrl}>{lang === 'fa' ? 'بازگشت به فهرست خدمات' : 'Back to all services'} <span aria-hidden="true">→</span></a>
            </div>
            <div class="related-services__grid">
              {props.relatedServices.map((service) => (
                <a class="related-service-card" href={`${baseClean}/${lang}/services/${service.slug}/`}>
                  <small>{service.tag}</small>
                  <strong>{service.title}</strong>
                  <span>{service.summary}</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>
    </section>
  )}

  <!-- FAQ -->
  {props.faqs && props.faqs.length > 0 && (
    <section class="content-section content-section--alt" aria-labelledby="faq-title">
      <div class="container">
        <div class="section-header reveal">
          <h2 id="faq-title">{lang==='fa' ? 'پرسش‌های متداول' : 'FAQ'}</h2>
        </div>
        <div class="faq-list">
          {props.faqs.map(f => (
            <details class="faq-item reveal">
              <summary>{f.q}</summary>
              <div class="faq-item__answer">{f.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="content-section" aria-labelledby="cta-title">
    <div class="container">
      <div class="cta-block reveal">
        <div>
          <h2 id="cta-title">{props.ctaTitle || (lang === 'fa' ? 'برای بررسی نیاز مجموعه‌تان گفت‌وگو کنیم' : 'Let’s discuss your organization’s needs')}</h2>
          <p>{props.ctaBody || (lang === 'fa' ? 'شرح کوتاهی از نیاز مجموعه، زمان‌بندی موردنظر و جزئیات مرتبط را با ما در میان بگذارید تا کارشناس قزوین تصویر درخواست شما را بررسی و برای گام بعدی راهنمایی‌تان کند.' : 'Share a brief overview of your requirement, key details and preferred timing. A Qazvin Tasvir specialist will review your request and guide you on the next steps.')}</p>
        </div>
        <a href={`${baseClean}/${lang}/contact/`} class="btn btn--accent btn--lg">{props.ctaLabel || (lang === 'fa' ? 'درخواست مشاوره' : 'Request a consultation')} →</a>
      </div>
    </div>
  </section>

  <slot />
</BaseLayout>

<style>
  @media (max-width: 860px) {
    .intro-layout { grid-template-columns: 1fr !important; }
    .process-steps { grid-template-columns: 1fr 1fr !important; }
  }
  @media (max-width: 560px) {
    .process-steps { grid-template-columns: 1fr !important; }
  }
  .eyebrow { display:inline-flex; padding:6px 12px; border-radius:9999px; background:rgba(255,255,255,0.12); border:1px solid rgba(255,255,255,0.16); font-size:0.78rem; font-weight:700; margin-bottom:16px; color:#fff; }
</style>
