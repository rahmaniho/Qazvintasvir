---
import BaseLayout from './BaseLayout.astro';
interface Props {
  lang: 'fa' | 'en';
  title?: string;
  description?: string;
  canonical?: string;
  hreflang?: any;
  schema?: any;
}
const { lang, title, description, canonical, hreflang, schema } = Astro.props;
---

<BaseLayout lang={lang} title={title} description={description} canonical={canonical} hreflang={hreflang} schema={schema}>
  <slot slot="head" name="head" />
  <slot />
  <script is:inline>
    (() => {
      const pageByLegacyHash = {
        about: 'about', services: 'services', fleet: 'fleet', brands: 'brands',
        'why-us': 'why-us', clients: 'clients', trust: 'trust', resume: 'resume',
        legal: 'legal', contact: 'contact',
      };
      const language = location.pathname.match(/\/(fa|en)\/?$/)?.[1];
      let oldHash = '';
      try { oldHash = decodeURIComponent(location.hash.slice(1)); } catch { oldHash = location.hash.slice(1); }
      const page = pageByLegacyHash[oldHash];
      if (!language || !page) return;
      const base = document.documentElement.dataset.base || '';
      location.replace(`${base}/${language}/${page}/`);
    })();
  </script>
</BaseLayout>
