---
import Header from '../components/nav/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl } from '../i18n/utils';
import { webPageSchema, organizationSchema, websiteSchema } from '../lib/schema';
import { createSeoMetadata } from '../lib/seo';
import fa from '../i18n/fa';
import en from '../i18n/en';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/utilities.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'fa' | 'en';
  image?: string;
  imageAlt?: string;
  canonical?: string;
  noindex?: boolean;
  schema?: any;
  hreflang?: Array<{ lang: string; href: string }>;
  bodyClass?: string;
  ogType?: 'website' | 'article';
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  preloadImage?: string;
  preloadImageType?: string;
}

const {
  title: propTitle,
  description: propDesc,
  lang: propLang,
  image: propImage,
  imageAlt: propImageAlt,
  canonical: propCanonical,
  noindex,
  bodyClass,
  schema,
  hreflang,
  ogType,
  articlePublishedTime,
  articleModifiedTime,
  preloadImage: propPreloadImage,
  preloadImageType
} = Astro.props;

const url = Astro.url;
const site = Astro.site?.toString() || 'https://qazvintasvir.ir';
const base = import.meta.env.BASE_URL; // / on the custom-domain deployment
const baseClean = base.endsWith('/') ? base.slice(0,-1) : base;
const siteClean = site.endsWith('/') ? site.slice(0,-1) : site;

// lang derived
const lang = propLang ?? getLangFromUrl(url);
const dir = lang === 'fa' ? 'rtl' : 'ltr';
const t = lang === 'fa' ? fa : en;

const title = propTitle ?? t.siteTitle;
const description = propDesc ?? t.siteDescription;
const seo = createSeoMetadata({
  url,
  site: siteClean,
  base: baseClean,
  lang,
  title,
  description,
  canonical: propCanonical,
  image: propImage,
  imageAlt: propImageAlt,
  noindex,
  hreflang,
});
const { canonical, image: ogImage, imageAlt: ogImageAlt, robots: robotsContent } = seo;
const hreflangLinks = seo.hreflang;
const preloadImage = propPreloadImage ?? `${baseClean}/assets/img/sections/hero-port.webp`;
const preloadImageMime = preloadImageType ?? 'image/webp';
const otherLocale = seo.alternateLocale;

const currentPath = url.pathname;
const siteUrl = `${siteClean}${baseClean}`;
const organization = noindex ? null : organizationSchema(siteUrl, lang);
const website = noindex ? null : websiteSchema(siteUrl, lang);
const pageSchema = noindex
  ? null
  : webPageSchema({ url: canonical, title, description, lang, image: ogImage, siteUrl });
---

<!doctype html>
<html lang={lang} dir={dir} data-base={baseClean}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content={lang === 'fa' ? 'شرکت قزوین تصویر' : 'Qazvin Tasvir Company'} />
  <meta name="google-site-verification" content="MBflR_hp5tDbD_VXkspc-6f1pcbB59wfEr45Ye3VnRw" />
  <meta name="robots" content={robotsContent} />
  <link rel="canonical" href={canonical} />
  {hreflangLinks.map(l => <link rel="alternate" hreflang={l.lang} href={l.href} />)}

  <meta property="og:type" content={ogType ?? 'website'} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta property="og:locale" content={seo.locale} />
  <meta property="og:locale:alternate" content={otherLocale} />
  <meta property="og:site_name" content={seo.siteName} />
  {ogType === 'article' && articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
  {ogType === 'article' && articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonical} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={ogImageAlt} />
  <meta name="theme-color" content="#0A2540" />
  <link rel="icon" href={`${baseClean}/favicon.ico`} sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href={`${baseClean}/assets/images/brand/qazvin-tasvir-icon-32.png`} />
  <link rel="icon" type="image/png" sizes="48x48" href={`${baseClean}/assets/images/brand/qazvin-tasvir-icon-48.png`} />
  <link rel="icon" type="image/png" sizes="96x96" href={`${baseClean}/assets/images/brand/qazvin-tasvir-icon-96.png`} />
  <link rel="icon" type="image/png" sizes="144x144" href={`${baseClean}/assets/images/brand/qazvin-tasvir-icon-144.png`} />
  <link rel="apple-touch-icon" sizes="180x180" href={`${baseClean}/assets/images/brand/qazvin-tasvir-apple-touch.png`} />

  {lang === 'fa' && <link rel="preload" href={`${baseClean}/fonts/fonts/BNazanin.woff`} as="font" type="font/woff" crossorigin />}
  {lang === 'fa' && <link rel="preload" href={`${baseClean}/fonts/fonts/BTitrBold.woff`} as="font" type="font/woff" crossorigin />}
  <link rel="preload" href={preloadImage} as="image" type={preloadImageMime} fetchpriority="high" />

  <script is:inline>
    (function(){
      document.documentElement.classList.add('js');
      try {
        var t = localStorage.getItem('qt-theme');
        if(t === 'dark' || t === 'ocean') document.documentElement.setAttribute('data-theme', t);
      } catch(e){}
    })();
  </script>
  {organization && <script type="application/ld+json" set:html={JSON.stringify(organization)} />}
  {website && <script type="application/ld+json" set:html={JSON.stringify(website)} />}
  {pageSchema && <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />}
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  <slot name="head" />
</head>
<body class={bodyClass} data-copy-phone-message={lang === 'fa' ? 'شماره‌ی تماس کپی شد.' : 'Phone number copied.'}>
  <a class="skip-link" href="#main-content">{t.nav.skipToContent}</a>
  <div id="scroll-progress" class="scroll-progress" aria-hidden="true"></div>
  <Header lang={lang} currentPath={currentPath} />
  <main id="main-content">
    <slot />
  </main>
  <Footer lang={lang} />

  <div id="toast-notice" class="toast" role="status" aria-live="polite">
    <span id="toast-text"></span>
  </div>

  <script is:inline>
    // Reveal with IntersectionObserver
    (function(){
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const obs = new IntersectionObserver((entries, o) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.classList.add('is-revealed');
              o.unobserve(e.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
        els.forEach(el => obs.observe(el));
      } else {
        els.forEach(el => el.classList.add('is-revealed'));
      }
    })();
    // Back to top
    (function(){
      const btn = document.getElementById('back-to-top');
      if (!btn) return;
      const onScroll = () => btn.classList.toggle('is-visible', window.scrollY > 500);
      window.addEventListener('scroll', onScroll, {passive:true});
      onScroll();
      btn.addEventListener('click', () => {
        const rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: rm ? 'auto' : 'smooth' });
      });
    })();
    // Toast helpers globally
    window.showToast = function(msg){
      const toast = document.getElementById('toast-notice');
      const txt = document.getElementById('toast-text');
      if(!toast) return;
      if(txt) txt.textContent = msg;
      toast.classList.add('is-active');
      clearTimeout(window._toastTimer);
      window._toastTimer = setTimeout(() => toast.classList.remove('is-active'), 3500);
    };
    // Copy phone
    document.querySelectorAll('[data-copy-phone]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const phone = '09122815189';
        const phoneMessage = document.body?.getAttribute('data-copy-phone-message') || 'Phone number copied.';
        if(navigator.clipboard?.writeText){
          navigator.clipboard.writeText(phone).then(() => window.showToast(phoneMessage)).catch(() => window.showToast('+98 912 281 5189'));
        } else window.showToast('+98 912 281 5189');
      });
    });
    // Theme switch (injected if exists)
    const savedTheme = (() => {
      try { return localStorage.getItem('qt-theme') || 'light'; } catch { return 'light'; }
    })();
    const updateThemeButtons = (theme) => {
      document.querySelectorAll('.theme-option').forEach((button) => {
        button.setAttribute('aria-pressed', button.getAttribute('data-theme-value') === theme ? 'true' : 'false');
      });
    };
    updateThemeButtons(savedTheme);
    document.querySelectorAll('.theme-option').forEach(btn => {
      btn.addEventListener('click', () => {
        const theme = btn.getAttribute('data-theme-value');
        if (theme === 'light') document.documentElement.removeAttribute('data-theme');
        else if (theme === 'dark' || theme === 'ocean') document.documentElement.setAttribute('data-theme', theme);
        try { localStorage.setItem('qt-theme', theme || 'light'); } catch {}
        updateThemeButtons(theme || 'light');
        const parent = btn.closest('details.theme-switch');
        if (parent) parent.open = false;
      });
    });
    document.querySelectorAll('details.theme-switch').forEach((details) => {
      details.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        details.open = false;
        details.querySelector('summary')?.focus();
      });
    });
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Node)) return;
      document.querySelectorAll('details.theme-switch[open]').forEach((details) => {
        if (!details.contains(event.target)) details.open = false;
      });
    });
    // Preserve legacy home-page hash links by routing the old service anchors to their dedicated pages.
    const legacyHashRoutes = {
      'fleet-specs': ['urban-vip', 'fleet-specs'],
      'personnel-food': ['personnel-food', 'personnel-food'],
      'food-menu': ['personnel-food', 'food-menu'],
      'food-gallery': ['personnel-food', 'food-gallery'],
      'food-request': ['personnel-food', 'food-request'],
      'food-faq': ['personnel-food', 'food-faq'],
    };
    let currentHash = '';
    try { currentHash = decodeURIComponent(window.location.hash.slice(1)); } catch {}
    const legacyRoute = legacyHashRoutes[currentHash];
    if (legacyRoute && !document.getElementById(currentHash)) {
      const basePath = document.documentElement.dataset.base || '';
      window.location.replace(`${basePath}/fa/services/${legacyRoute[0]}/#${legacyRoute[1]}`);
    }
  </script>
  <slot name="scripts" />
</body>
</html>
